<Window x:Class="WallpaperTurbo.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WallpaperTurbo.UI"
        xmlns:views="clr-namespace:WallpaperTurbo.UI.Views"
        xmlns:vm="clr-namespace:WallpaperTurbo.UI.ViewModels"
        mc:Ignorable="d"
        Title="Wallpaper Turbo" 
        Icon="Assets/Branding/wallpaper-turbo.png"
        Height="780" Width="1240"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <!-- Configure WindowChrome to remove native OS titlebar while retaining resizing/snap layouts -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <!-- MVVM Content DataTemplate Mappings -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Root grid layout trigger to prevent screen clipping when window is maximized -->
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation Column -->
            <ColumnDefinition Width="250" />
            <!-- Main Content Area Column -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT SIDEBAR PANEL                         -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#0A0B10" BorderBrush="#10FFFFFF" BorderThickness="0,0,1,0" Padding="0,16,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Logo -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Items -->
                    <RowDefinition Height="*" />
                    <!-- Spacing Separator -->
                    <RowDefinition Height="Auto" />
                    <!-- Now Playing Card -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- BRAND LOGO HEADER -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,12,20,16">
                    <!-- Official brand logo image replacing mockup vector path with crisp HighQuality scaling and snapping -->
                    <Image Source="Assets/Branding/wallpaper-turbo.png"
                           Width="42" 
                           Height="42" 
                           Margin="0,0,12,0" 
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
                        </Image.Effect>
                    </Image>
                    
                    <StackPanel VerticalAlignment="Center">
                        <!-- Main Title -->
                        <TextBlock Text="WALLPAPER" FontSize="15" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                        <TextBlock Text="TURBO" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ActiveCyanBrush}" Margin="0,-4,0,0" />
                        <!-- Subtitle -->
                        <TextBlock Text="LIVE DESKTOP ENGINE" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- NAVIGATION BUTTON LIST -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,0,10">
                        <RadioButton Content="Dashboard" Tag="Home24" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Library" Tag="Library24" Command="{Binding NavigateCommand}" CommandParameter="Library" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Playlists" Tag="Play24" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Monitor Setup" Tag="Desktop24" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Engine" Tag="Power24" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Performance" Tag="Flash24" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Settings" Tag="Settings24" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="About" Tag="Info24" Style="{StaticResource SidebarButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- SUBTLE SEPARATOR FOR LOWER SIDEBAR -->
                <Border Grid.Row="2" Height="1" Background="#12FFFFFF" Margin="20,8,20,12" VerticalAlignment="Center"/>

                <!-- NOW PLAYING CYBER WIDGET -->
                <Border Grid.Row="3" Style="{StaticResource NeonCardStyle}" Margin="12,0,12,12" Padding="12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <!-- Mini Artwork / Graphic Placeholder -->
                        <Border Grid.Row="0" CornerRadius="8" Height="90" Margin="0,0,0,10" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0D0E15" Offset="0" />
                                    <GradientStop Color="#1A0D36" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <!-- Cyber vector animation -->
                            <Path Data="M 10,45 Q 40,10 80,40 T 150,5" Stroke="{StaticResource NeonPurpleCyanGradient}" StrokeThickness="1" Opacity="0.5" VerticalAlignment="Center" />
                        </Border>

                        <!-- Media Title & Specs -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ActiveWallpaperTitle}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ActiveWallpaperSpecs}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <!-- Media Progress Scrubber -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="01:24" FontSize="9" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            
                            <!-- Glowing Scrubber bar -->
                            <ProgressBar Grid.Column="1" Value="35" Height="3" Margin="8,0" Background="#15FFFFFF" Foreground="{StaticResource ActiveCyanBrush}">
                                <ProgressBar.Effect>
                                    <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="4" ShadowDepth="0" Opacity="0.2" />
                                </ProgressBar.Effect>
                            </ProgressBar>
                            
                            <TextBlock Grid.Column="2" Text="03:47" FontSize="9" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Real-time Playback Media Controls -->
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Play/Pause Toggle button with cyber-active styling -->
                            <ui:Button Grid.Column="1" 
                                       Width="38" 
                                       Height="38" 
                                       CornerRadius="19" 
                                       Padding="0"
                                       Background="#15FFFFFF" 
                                       BorderBrush="#3066FCF1"
                                       BorderThickness="1"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Command" Value="{Binding PauseCommand}" />
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <ui:SymbolIcon Symbol="Pause24" FontSize="16" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Foreground" Value="{StaticResource ActiveCyanBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                                <Setter Property="Command" Value="{Binding PlayCommand}" />
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <ui:SymbolIcon Symbol="Play24" FontSize="16" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Foreground" Value="{StaticResource ActiveGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <ui:Button.Effect>
                                    <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.15" />
                                </ui:Button.Effect>
                            </ui:Button>

                            <!-- Stop/Cancel Playback button styled with WarningRed -->
                            <ui:Button Grid.Column="3" 
                                       Command="{Binding StopCommand}"
                                       Width="38" 
                                       Height="38" 
                                       CornerRadius="19" 
                                       Padding="0"
                                       Background="#15FFFFFF" 
                                       BorderBrush="#30FF3366"
                                       BorderThickness="1"
                                       Foreground="{StaticResource WarningRedBrush}"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                                <ui:Button.Effect>
                                    <DropShadowEffect Color="{StaticResource WarningRedColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.15" />
                                </ui:Button.Effect>
                            </ui:Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- RIGHT CONTENT AND HEADER REGION            -->
        <!-- ========================================== -->
        <Grid Grid.Column="1" Background="#070911">
            <Grid.RowDefinitions>
                <!-- Custom Titlebar & Premium Command bar -->
                <RowDefinition Height="Auto" />
                <!-- Central Presenter Workspace -->
                <RowDefinition Height="*" />
                <!-- Performance Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- WPF-UI Native Snap Titlebar & Command Header -->
            <Grid Grid.Row="0" Height="64">
                <!-- TitleBar spans only the far right button section to avoid intercepting custom button clicks, while retaining native window control snaps -->
                <ui:TitleBar Title="" Height="64" HorizontalAlignment="Right" Width="140" VerticalAlignment="Stretch" Padding="0,0,8,0"/>
                
                <!-- Our custom Command Bar content overlay (interactivity is preserved because interactive buttons are hit-testable, while blank space clicks through to titlebar) -->
                <Border Padding="24,12" Height="64" VerticalAlignment="Center" Background="{x:Null}" IsHitTestVisible="True" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <!-- Center glowing engineering slogan tagline -->
                        <TextBlock Text="LIVE DESKTOP. MAX PERFORMANCE." 
                                   Foreground="{StaticResource NeonPurpleCyanGradient}"
                                   FontFamily="Segoe UI Variable Display, Inter"
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left" />

                        <!-- Right Command controls (leaving ~130px on the far right for the native Min/Max/Close buttons inside TitleBar) -->
                        <StackPanel WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,130,0">
                            <!-- Monitor Selector combobox with screen icon -->
                            <ComboBox Height="30" Width="130" SelectedIndex="0" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,8,0"/>
                                        <TextBlock Text="Monitor 1" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>

                            <!-- Layout Switch button -->
                            <ui:Button Icon="Grid24" Appearance="Secondary" Margin="0,0,8,0" Padding="8,6" WindowChrome.IsHitTestVisibleInChrome="True" />

                            <!-- Glowing Accent + Import Button -->
                            <ui:Button Content="+ Import" Command="{Binding ImportWallpaperCommand}" Style="{StaticResource NeonImportButtonStyle}" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True" />

                            <!-- Header status action shortcuts -->
                            <ui:Button Icon="AlertUrgent24" Appearance="Transparent" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" Padding="6" WindowChrome.IsHitTestVisibleInChrome="True" />
                            <ui:Button Icon="Settings24" Appearance="Transparent" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" Padding="6" WindowChrome.IsHitTestVisibleInChrome="True" />
                            
                            <!-- Profile picture border matching mockup -->
                            <Border Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="{StaticResource ActiveGreenBrush}" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Ellipse Width="20" Height="20" Fill="#20FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- CENTRAL DYNAMIC MVVM WORKSPACE -->
            <ContentPresenter Grid.Row="1" Content="{Binding CurrentPageViewModel}" Margin="24,8,24,12" />

            <!-- ========================================== -->
            <!-- UNIFIED CYBERNETIC FOOTER PANEL            -->
            <!-- ========================================== -->
            <Border Grid.Row="2" Background="#090B12" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left/Center: Metrics row separated by thin cyber borders -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                        <!-- FPS metric -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Heart24" Foreground="{StaticResource ActivePurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="FPS" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding FpsText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- GPU metric -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" Foreground="{StaticResource ActiveCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="GPU LOAD" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding GpuText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- VRAM metric -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" Foreground="{StaticResource ActivePurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="VRAM" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding VramText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- RAM metric -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" Foreground="{StaticResource ActiveCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="RAM USAGE" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding RamText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Uptime metric -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Foreground="{StaticResource ActivePurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="UPTIME" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding UptimeText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Resolution -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" Foreground="{StaticResource ActiveCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="RESOLUTION" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="3840 x 2160" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Active Renderer -->
                        <Border Padding="0" Margin="0,4,0,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" Foreground="{StaticResource ActivePurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="RENDERER" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding ActiveRendererText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Right: Premium Max Performance Optimized Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border BorderBrush="#2566FCF1" BorderThickness="1" CornerRadius="8" Background="#0866FCF1" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 0,6 L 6,6 L 3,12 L 8,4 L 3,4 L 5,0 Z" Fill="{StaticResource ActiveCyanBrush}" Width="8" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="OPTIMIZED" FontSize="8" FontWeight="ExtraBold" Foreground="{StaticResource ActiveCyanBrush}" />
                                    <TextBlock Text="MAX PERFORMANCE" FontSize="6" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Version Tag -->
                        <TextBlock Text="v2.1.0" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- PREMIUM GLOWING IN-APP MODAL OVERLAY -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="1000" Visibility="{Binding IsDialogVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#D8080A10" />
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Background="#0F121D" BorderBrush="{StaticResource WarningRedBrush}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource WarningRedColor}" BlurRadius="30" ShadowDepth="0" Opacity="0.4" />
                </Border.Effect>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Title with cyber icon -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="AlertUrgent24" Foreground="{StaticResource WarningRedBrush}" Margin="0,0,10,0" VerticalAlignment="Center" Filled="True"/>
                        <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource WhiteTextBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Inter, Segoe UI"/>
                    </StackPanel>
                    
                    <!-- Dialog Message -->
                    <TextBlock Grid.Row="1" Text="{Binding DialogMessage}" FontSize="12" Foreground="#C8D2E6" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="18" FontFamily="Segoe UI Variable Text, Inter, Segoe UI"/>
                    
                    <!-- Dynamic Cancel/Confirm Action buttons styled with scifi transitions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Cancel Button (Only shown when IsDialogCancelVisible is True) -->
                        <ui:Button Content="Cancel" 
                                   Command="{Binding DialogCancelCommand}" 
                                   Width="90" 
                                   Height="34" 
                                   Margin="0,0,12,0" 
                                   Appearance="Secondary" 
                                   Background="#15FFFFFF" 
                                   Foreground="{StaticResource WhiteTextBrush}" 
                                   BorderThickness="0" 
                                   CornerRadius="8"
                                   Visibility="{Binding IsDialogCancelVisible, Converter={StaticResource BoolToVisConverter}}" />
                        <!-- Confirm/Yes Button -->
                        <ui:Button Content="Confirm" 
                                   Command="{Binding DialogConfirmCommand}" 
                                   Width="100" 
                                   Height="34" 
                                   Background="{StaticResource WarningRedBrush}" 
                                   Foreground="{StaticResource WhiteTextBrush}" 
                                   BorderThickness="0"
                                   CornerRadius="8" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
