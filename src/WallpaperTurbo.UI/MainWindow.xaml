<Window x:Class="WallpaperTurbo.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WallpaperTurbo.UI"
        xmlns:views="clr-namespace:WallpaperTurbo.UI.Views"
        xmlns:vm="clr-namespace:WallpaperTurbo.UI.ViewModels"
        mc:Ignorable="d"
        Title="Wallpaper Turbo"
        Icon="Assets/Branding/wallpaper-turbo.png"
        Height="780" Width="1240"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource Surface0Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,18,20,20">
                    <Image Source="Assets/Branding/wallpaper-turbo.png"
                           Width="28" Height="28"
                           Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Wallpaper Turbo"
                                   FontSize="14"
                                   FontWeight="600"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Live desktop engine"
                                   FontSize="10"
                                   FontWeight="500"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel>
                        <RadioButton Content="Dashboard"
                                     Tag="Home24"
                                     IsChecked="True"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Dashboard"
                                     Style="{StaticResource NavItem}" />
                        <RadioButton Content="Library"
                                     Tag="Library24"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Library"
                                     Style="{StaticResource NavItem}" />
                        <RadioButton Content="Playlists"
                                     Tag="Play24"
                                     Style="{StaticResource NavItem}" />
                        <RadioButton Content="Monitor setup"
                                     Tag="Desktop24"
                                     Style="{StaticResource NavItem}" />
                        <RadioButton Content="Engine"
                                     Tag="Power24"
                                     Style="{StaticResource NavItem}" />
                        <RadioButton Content="Performance"
                                     Tag="Flash24"
                                     Style="{StaticResource NavItem}" />
                        <RadioButton Content="Settings"
                                     Tag="Settings24"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Settings"
                                     Style="{StaticResource NavItem}" />
                        <RadioButton Content="About"
                                     Tag="Info24"
                                     Style="{StaticResource NavItem}" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="{StaticResource Surface1Brush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Margin="12,8,12,12"
                        Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Grid Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource StatusOkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock FontSize="11"
                                       FontWeight="600"
                                       Foreground="{StaticResource TextPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Engine offline" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                <Setter Property="Text" Value="Engine running" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{Binding ActiveRendererText}"
                                   FontSize="10"
                                   FontWeight="500"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FPS" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding FpsText}" Style="{StaticResource MonoStyle}" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VRAM" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding VramText}" Style="{StaticResource MonoStyle}" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Button Command="{Binding ToggleEngineCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                    <Setter Property="Content" Value="Resume engine" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Content" Value="Pause engine" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource WindowRadialGradient}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="56">
                <ui:TitleBar Title="" Height="56" HorizontalAlignment="Right" Width="140" VerticalAlignment="Stretch" Padding="0,0,8,0" />

                <Border Padding="24,8" Height="56" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <ui:TextBox PlaceholderText="Search wallpapers, tags, or resolution…"
                                    Style="{StaticResource Input}"
                                    Width="520"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,140,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Content="Import"
                                    Command="{Binding ImportWallpaperCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    Margin="0,0,8,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button Style="{StaticResource ButtonGhost}"
                                    ToolTip="Notifications"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <ui:SymbolIcon Symbol="Alert24" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource ButtonGhost}"
                                    ToolTip="Settings"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Margin="4,0,0,0">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                            </Button>
                            <Border Width="28" Height="28"
                                    CornerRadius="14"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Margin="24,8,24,0"
                    Padding="16,12"
                    Style="{StaticResource Card}"
                    Visibility="{Binding Updater.IsNotificationVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="ArrowSync24"
                                       FontSize="20"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Updater.AvailableVersionText}"
                                       FontSize="13"
                                       FontWeight="600"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Updater.StatusText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Updater.IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ProgressBar Value="{Binding Updater.ProgressPercent, Mode=OneWay}"
                                     Minimum="0" Maximum="100" Height="4"
                                     Background="{StaticResource Surface2Brush}"
                                     Foreground="{StaticResource AccentBrush}"
                                     BorderThickness="0" />
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding Updater.ProgressText}" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding Updater.DownloadSpeedText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Download"
                                   Command="{Binding Updater.DownloadCommand}"
                                   Visibility="{Binding Updater.IsDownloadButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                                   Icon="ArrowDownload24"
                                   Appearance="Primary"
                                   Height="32"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Install update"
                                   Command="{Binding RequestInstallUpdateCommand}"
                                   Visibility="{Binding Updater.IsInstallButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                                   Icon="Checkmark24"
                                   Appearance="Primary"
                                   Height="32"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Cancel"
                                   Command="{Binding Updater.CancelCommand}"
                                   Visibility="{Binding Updater.IsCancelButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                                   Icon="Dismiss24"
                                   Appearance="Secondary"
                                   Height="32"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding Updater.DismissNotificationCommand}"
                                   Icon="Dismiss24"
                                   Appearance="Transparent"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Height="32"
                                   Width="32"
                                   ToolTip="Dismiss" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentPresenter Grid.Row="2"
                              Content="{Binding CurrentPageViewModel}"
                              Margin="24,16,24,24" />
        </Grid>

        <Grid Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="1000" Visibility="{Binding IsDialogVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#D8080A10" />
            <Border Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource StatusErrBrush}"
                    BorderThickness="1">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="AlertUrgent24"
                                       Foreground="{StaticResource StatusErrBrush}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Filled="True" />
                        <TextBlock Text="{Binding DialogTitle}"
                                   FontSize="16"
                                   FontWeight="600"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding DialogMessage}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"
                               LineHeight="20" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel"
                                   Command="{Binding DialogCancelCommand}"
                                   Width="90"
                                   Height="34"
                                   Margin="0,0,12,0"
                                   Appearance="Secondary"
                                   Background="{StaticResource Surface2Brush}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   BorderThickness="0"
                                   CornerRadius="{StaticResource RadiusSmall}"
                                   Visibility="{Binding IsDialogCancelVisible, Converter={StaticResource BoolToVisConverter}}" />
                        <ui:Button Content="Confirm"
                                   Command="{Binding DialogConfirmCommand}"
                                   Width="100"
                                   Height="34"
                                   Background="{StaticResource StatusErrBrush}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   BorderThickness="0"
                                   CornerRadius="{StaticResource RadiusSmall}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
