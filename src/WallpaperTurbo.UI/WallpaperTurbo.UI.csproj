<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WallpaperTurbo.Core\WallpaperTurbo.Core.csproj" />
    <ProjectReference Include="..\WallpaperTurbo.Updater\WallpaperTurbo.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.8" />
    <PackageReference Include="wpf-ui" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Branding\wallpaper-turbo.ico</ApplicationIcon>
    <Version>1.3.8</Version>
    <AssemblyVersion>1.3.8.0</AssemblyVersion>
    <FileVersion>1.3.8.0</FileVersion>
    <InformationalVersion>1.3.8</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Branding\wallpaper-turbo.ico" />
    <Resource Include="Assets\Branding\wallpaper-turbo.png" />
  </ItemGroup>

  <!-- Automatically publish the AppRunner background engine to the same directory when UI is published -->
  <Target Name="PublishAppRunner" AfterTargets="Publish">
    <MSBuild Projects="..\WallpaperTurbo.AppRunner\WallpaperTurbo.AppRunner.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)" />
  </Target>

  <Target Name="ExcludeLibVlcFromSingleFile" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('libvlc'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="CopyLibVlcToPublish" AfterTargets="PublishAppRunner">
    <ItemGroup>
      <LibVlcFiles Include="..\WallpaperTurbo.AppRunner\bin\x64\$(Configuration)\net8.0-windows\win-x64\libvlc\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibVlcFiles)"
          DestinationFolder="$(PublishDir)libvlc\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
