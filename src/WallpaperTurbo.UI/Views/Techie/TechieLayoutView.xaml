<UserControl x:Class="WallpaperTurbo.UI.Views.TechieLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:WallpaperTurbo.UI.Views"
             xmlns:vm="clr-namespace:WallpaperTurbo.UI.ViewModels"
             xmlns:views="clr-namespace:WallpaperTurbo.UI.Views"
             xmlns:models="clr-namespace:WallpaperTurbo.UI.Models"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1240">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:TechieDashboardView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Root grid layout trigger to prevent screen clipping when window is maximized -->
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation Column -->
            <ColumnDefinition Width="250" />
            <!-- Main Content Area Column -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT SIDEBAR PANEL                         -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#0A0B10" BorderBrush="#10FFFFFF" BorderThickness="0,0,1,0" Padding="0,16,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Logo -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Items -->
                    <RowDefinition Height="*" />
                    <!-- Spacing Separator -->
                    <RowDefinition Height="Auto" />
                    <!-- Now Playing Card -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- BRAND LOGO HEADER -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,12,20,16">
                    <!-- Official brand logo image replacing mockup vector path with crisp HighQuality scaling and snapping -->
                    <Image Source="../../Assets/Branding/wallpaper-turbo.png"
                           Width="42" 
                           Height="42" 
                           Margin="0,0,12,0" 
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
                        </Image.Effect>
                    </Image>
                    
                    <StackPanel VerticalAlignment="Center">
                        <!-- Main Title -->
                        <TextBlock Text="WALLPAPER" FontSize="15" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                        <TextBlock Text="TURBO" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ActiveCyanBrush}" Margin="0,-4,0,0" />
                        <!-- Subtitle -->
                        <TextBlock Text="LIVE DESKTOP ENGINE" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- NAVIGATION BUTTON LIST -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,0,10">
                        <RadioButton Content="Dashboard" Tag="Home24" IsChecked="{Binding IsDashboardActive, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Library" Tag="Library24" IsChecked="{Binding IsLibraryActive, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Library" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Playlists" Tag="Play24" Command="{Binding ShowFeatureComingSoonCommand}" CommandParameter="Playlists" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Monitor Setup" Tag="Desktop24" Command="{Binding ShowFeatureComingSoonCommand}" CommandParameter="Monitor Setup" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Engine" Tag="Power24" Command="{Binding ShowFeatureComingSoonCommand}" CommandParameter="Engine" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Performance" Tag="Flash24" Command="{Binding ShowFeatureComingSoonCommand}" CommandParameter="Performance" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="Settings" Tag="Settings24" IsChecked="{Binding IsSettingsActive, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource SidebarButtonStyle}" />
                        <RadioButton Content="About" Tag="Info24" Command="{Binding ShowFeatureComingSoonCommand}" CommandParameter="About" Style="{StaticResource SidebarButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- SUBTLE SEPARATOR FOR LOWER SIDEBAR -->
                <Border Grid.Row="2" Height="1" Background="#12FFFFFF" Margin="20,8,20,12" VerticalAlignment="Center"/>

                <!-- NOW PLAYING CYBER WIDGET -->
                <Border Grid.Row="3" Style="{StaticResource NeonCardStyle}" Margin="12,0,12,12" Padding="12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <!-- Mini Artwork / Graphic Placeholder -->
                        <Border Grid.Row="0" CornerRadius="8" Height="90" Margin="0,0,0,10" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0D0E15" Offset="0" />
                                    <GradientStop Color="#1A0D36" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <!-- Cyber vector animation -->
                            <Path Data="M 10,45 Q 40,10 80,40 T 150,5" Stroke="{StaticResource NeonPurpleCyanGradient}" StrokeThickness="1" Opacity="0.5" VerticalAlignment="Center" />
                        </Border>

                        <!-- Media Title & Specs -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ActiveWallpaperTitle, FallbackValue='Now Playing'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ActiveWallpaperSpecs, FallbackValue='3840 x 2160'}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <!-- Media Progress Scrubber -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="01:24" FontSize="9" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            
                            <!-- Glowing Scrubber bar -->
                            <ProgressBar Grid.Column="1" Value="35" Height="3" Margin="8,0" Background="#15FFFFFF" Foreground="{StaticResource ActiveCyanBrush}">
                                <ProgressBar.Effect>
                                    <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="4" ShadowDepth="0" Opacity="0.2" />
                                </ProgressBar.Effect>
                            </ProgressBar>
                            
                            <TextBlock Grid.Column="2" Text="03:47" FontSize="9" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Real-time Playback Media Controls -->
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Play/Pause Toggle button with cyber-active styling -->
                            <ui:Button Grid.Column="1" 
                                       Width="38" 
                                       Height="38" 
                                       CornerRadius="19" 
                                       Padding="0"
                                       Background="#15FFFFFF" 
                                       BorderBrush="#3066FCF1"
                                       BorderThickness="1"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Command="{Binding PlayCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Command" Value="{Binding PauseCommand}" />
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <ui:SymbolIcon Symbol="Pause24" FontSize="16" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Foreground" Value="{StaticResource ActiveCyanBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                                <Setter Property="Command" Value="{Binding PlayCommand}" />
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <ui:SymbolIcon Symbol="Play24" FontSize="16" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Foreground" Value="{StaticResource ActiveGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <ui:Button.Effect>
                                    <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.15" />
                                </ui:Button.Effect>
                            </ui:Button>

                            <!-- Stop/Cancel Playback button styled with WarningRed -->
                            <ui:Button Grid.Column="3" 
                                       Command="{Binding StopCommand}"
                                       Width="38" 
                                       Height="38" 
                                       CornerRadius="19" 
                                       Padding="0"
                                       Background="#15FFFFFF" 
                                       BorderBrush="#30FF3366"
                                       BorderThickness="1"
                                       Foreground="{StaticResource WarningRedBrush}"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                                <ui:Button.Effect>
                                    <DropShadowEffect Color="{StaticResource WarningRedColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.15" />
                                </ui:Button.Effect>
                            </ui:Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- RIGHT CONTENT AND HEADER REGION            -->
        <!-- ========================================== -->
        <Grid Grid.Column="1" Background="#070911">
            <Grid.RowDefinitions>
                <!-- Custom Titlebar & Premium Command bar -->
                <RowDefinition Height="Auto" />
                <!-- Non-intrusive Update Notification Banner -->
                <RowDefinition Height="Auto" />
                <!-- Central Presenter Workspace -->
                <RowDefinition Height="*" />
                <!-- Performance Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- WPF-UI Native Snap Titlebar & Command Header -->
            <Grid Grid.Row="0" Height="64">
                <!-- Our custom Command Bar content overlay (interactivity is preserved because interactive buttons are hit-testable, while blank space clicks through to titlebar) -->
                <Border Padding="24,12" Height="64" VerticalAlignment="Center" Background="{x:Null}" IsHitTestVisible="True" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <!-- Center glowing engineering slogan tagline -->
                        <TextBlock Text="LIVE DESKTOP. MAX PERFORMANCE." 
                                   Foreground="{StaticResource NeonPurpleCyanGradient}"
                                   FontFamily="Segoe UI Variable Display, Inter"
                                   FontSize="11" 
                                   FontWeight="ExtraBold"
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.3" />
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Right Command controls (leaving ~130px on the far right for the native Min/Max/Close buttons inside TitleBar) -->
                        <StackPanel WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,130,0">
                            <!-- Monitor Selector combobox with screen icon -->
                            <ComboBox Width="150" 
                                      ItemsSource="{Binding Monitors}" 
                                      SelectedItem="{Binding SelectedMonitor}" 
                                      Margin="0,0,8,0" 
                                      WindowChrome.IsHitTestVisibleInChrome="True">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4">
                                            <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,8,0" Foreground="{StaticResource ActiveCyanBrush}" FontSize="14" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Number, StringFormat='Monitor {0}'}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Resolution}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text=" • " FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding Type}" FontSize="9" Foreground="{StaticResource ActivePurpleBrush}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Layout Switch button -->
                            <ui:Button Margin="0,0,8,0" Padding="8,6" 
                                       WindowChrome.IsHitTestVisibleInChrome="True" 
                                       ToolTip="Switch to Minimal Layout" 
                                       Command="{Binding LayoutHost.SwitchLayoutCommand}" 
                                       CommandParameter="{x:Static models:LayoutMode.Minimal}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Foreground" Value="{StaticResource WhiteTextBrush}" />
                                        <Setter Property="Background" Value="#15FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#3066FCF1" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2566FCF1" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ActiveCyanBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource ActiveCyanBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <ui:SymbolIcon Symbol="Grid24" FontSize="14" />
                            </ui:Button>

                            <!-- Glowing Accent + Import Button -->
                            <ui:Button Content="+ Import" Command="{Binding ImportWallpaperCommand}" Style="{StaticResource NeonImportButtonStyle}" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True" />

                            <!-- Header status action shortcuts -->
                            <ui:Button Command="{Binding Updater.CheckForUpdatesCommand}"
                                       Margin="0,0,6,0" Padding="6" 
                                       WindowChrome.IsHitTestVisibleInChrome="True">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        <Setter Property="ToolTip" Value="Check for Updates" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Updater.IsNotificationVisible}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WarningRedBrush}" />
                                                <Setter Property="ToolTip" Value="Update Available! Click to download." />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="{StaticResource WarningRedColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.6" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ActiveCyanBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <ui:SymbolIcon Symbol="AlertUrgent24" FontSize="14" />
                            </ui:Button>

                            <ui:Button Margin="0,0,6,0" Padding="6" 
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       Command="{Binding NavigateCommand}"
                                       CommandParameter="Settings">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        <Setter Property="ToolTip" Value="Settings" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ActiveCyanBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <ui:SymbolIcon Symbol="Settings24" FontSize="14" />
                            </ui:Button>
                            
                            <!-- Profile picture border matching mockup -->
                            <Border Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="{StaticResource ActiveGreenBrush}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="User Session Active">
                                <Grid>
                                    <Ellipse Width="20" Height="20" Fill="#1000FF66"/>
                                    <ui:SymbolIcon Symbol="Person24" Foreground="{StaticResource ActiveGreenBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TitleBar spans only the far right button section to avoid intercepting custom button clicks, while retaining native window control snaps -->
                <ui:TitleBar Title="" Height="64" HorizontalAlignment="Right" Width="140" VerticalAlignment="Stretch" Padding="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- NON-INTRUSIVE UPDATE NOTIFICATION BANNER -->
            <Border Grid.Row="1"
                    Margin="24,8,24,0"
                    Padding="16,12"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#4066FCF1"
                    Background="#0D1626"
                    Visibility="{Binding Updater.IsNotificationVisible, Converter={StaticResource BoolToVisConverter}}">
                <Border.Effect>
                    <DropShadowEffect Color="#FF66FCF1" BlurRadius="14" ShadowDepth="0" Opacity="0.18" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: state icon + headline -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="ArrowSync24"
                                       FontSize="22"
                                       Foreground="{StaticResource ActiveCyanBrush}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Updater.AvailableVersionText}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding Updater.StatusText}"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: progress + speed while downloading/verifying -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Updater.IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ProgressBar Value="{Binding Updater.ProgressPercent, Mode=OneWay}"
                                     Minimum="0" Maximum="100" Height="4"
                                     Background="#15FFFFFF"
                                     Foreground="{StaticResource ActiveCyanBrush}" />
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding Updater.ProgressText}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Updater.DownloadSpeedText}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Right: action buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Download"
                                   Command="{Binding Updater.DownloadCommand}"
                                   Visibility="{Binding Updater.IsDownloadButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                                   Icon="ArrowDownload24"
                                   Appearance="Primary"
                                   Height="32"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Install Update"
                                   Command="{Binding RequestInstallUpdateCommand}"
                                   Visibility="{Binding Updater.IsInstallButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                                   Icon="Checkmark24"
                                   Appearance="Primary"
                                   Height="32"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Cancel"
                                   Command="{Binding Updater.CancelCommand}"
                                   Visibility="{Binding Updater.IsCancelButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                                   Icon="Dismiss24"
                                   Appearance="Secondary"
                                   Height="32"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding Updater.DismissNotificationCommand}"
                                   Icon="Dismiss24"
                                   Appearance="Transparent"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Height="32"
                                   Width="32"
                                   ToolTip="Dismiss" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTRAL DYNAMIC MVVM WORKSPACE -->
            <!-- ContentPresenter is NOT bound or wired in Step 2. Step 3 handles the binding. -->
            <ContentPresenter Grid.Row="2" Margin="24,8,24,12" Content="{Binding CurrentPageViewModel}" />

            <!-- UNIFIED CYBERNETIC FOOTER PANEL -->
            <Border Grid.Row="3" Background="#090B12" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left/Center: Metrics row separated by thin cyber borders -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                        <!-- FPS metric -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Heart24" Foreground="{StaticResource ActivePurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="FPS" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding FpsText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- GPU metric -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Glance24" Foreground="{StaticResource ActiveCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="GPU LOAD" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding GpuText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- VRAM metric -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" Foreground="{StaticResource ActivePurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="VRAM" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding VramText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- RAM metric -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" Foreground="{StaticResource ActiveCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="RAM USAGE" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding RamText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Uptime metric -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Clock24" Foreground="{StaticResource ActivePurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="UPTIME" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding UptimeText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Resolution -->
                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Height="32" Padding="0,0,12,0" Margin="0,4,12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" Foreground="{StaticResource ActiveCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="RESOLUTION" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="3840 x 2160" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Active Renderer -->
                        <Border Padding="0" Margin="0,4,0,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Video24" Foreground="{StaticResource ActivePurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="RENDERER" Style="{StaticResource TelemetryLabelStyle}" />
                                    <TextBlock Text="{Binding ActiveRendererText}" Style="{StaticResource TelemetryMetricStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Right: Premium Max Performance Optimized Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border BorderBrush="#2566FCF1" BorderThickness="1" CornerRadius="8" Background="#0866FCF1" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 0,6 L 6,6 L 3,12 L 8,4 L 3,4 L 5,0 Z" Fill="{StaticResource ActiveCyanBrush}" Width="8" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="OPTIMIZED" FontSize="8" FontWeight="ExtraBold" Foreground="{StaticResource ActiveCyanBrush}" />
                                    <TextBlock Text="MAX PERFORMANCE" FontSize="6" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Version Tag -->
                        <TextBlock Text="{Binding Updater.CurrentVersion, StringFormat=v{0}, FallbackValue=v1.0.0}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- PREMIUM GLOWING IN-APP MODAL OVERLAY -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="1000" Visibility="{Binding IsDialogVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#60080A10" />
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Background="#0F121D" BorderBrush="{StaticResource WarningRedBrush}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource WarningRedColor}" BlurRadius="30" ShadowDepth="0" Opacity="0.4" />
                </Border.Effect>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Title with cyber icon -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="AlertUrgent24" Foreground="{StaticResource WarningRedBrush}" Margin="0,0,10,0" VerticalAlignment="Center" Filled="True"/>
                        <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource WhiteTextBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Inter"/>
                    </StackPanel>
                    
                    <!-- Dialog Message -->
                    <TextBlock Grid.Row="1" Text="{Binding DialogMessage}" FontSize="12" Foreground="#C8D2E6" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="18" FontFamily="Segoe UI Variable Text, Inter"/>
                    
                    <!-- Dynamic Cancel/Confirm/Apply Action buttons styled with scifi transitions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" 
                                   Command="{Binding DialogCancelCommand}" 
                                   Width="90" 
                                   Height="34" 
                                   Margin="0,0,12,0" 
                                   Appearance="Secondary" 
                                   Background="#15FFFFFF" 
                                   Foreground="{StaticResource WhiteTextBrush}" 
                                   BorderThickness="0" 
                                   CornerRadius="8"
                                   Visibility="{Binding IsDialogCancelVisible, Converter={StaticResource BoolToVisConverter}}" />
                        <ui:Button Content="Confirm" 
                                   Command="{Binding DialogConfirmCommand}" 
                                   Width="100" 
                                   Height="34" 
                                   Margin="0,0,12,0" 
                                   Appearance="Secondary" 
                                   Background="#15FFFFFF" 
                                   Foreground="{StaticResource WhiteTextBrush}" 
                                   BorderThickness="0" 
                                   CornerRadius="8"
                                   Visibility="{Binding IsDialogApplyVisible, Converter={StaticResource BoolToVisConverter}}" />
                        <ui:Button Content="Confirm" 
                                   Command="{Binding DialogConfirmCommand}" 
                                   Width="100" 
                                   Height="34" 
                                   Background="{StaticResource WarningRedBrush}" 
                                   Foreground="{StaticResource WhiteTextBrush}" 
                                   BorderThickness="0"
                                   CornerRadius="8"
                                   Visibility="{Binding IsDialogApplyNotVisible, Converter={StaticResource BoolToVisConverter}}" />
                        <ui:Button Content="Apply" 
                                   Command="{Binding DialogApplyCommand}" 
                                   Width="100" 
                                   Height="34" 
                                   Background="{StaticResource WarningRedBrush}" 
                                   Foreground="{StaticResource WhiteTextBrush}" 
                                   BorderThickness="0"
                                   CornerRadius="8"
                                   Visibility="{Binding IsDialogApplyVisible, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
