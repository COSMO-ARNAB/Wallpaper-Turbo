                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="LeftArcOuter" Data="M -5,-10 A 13,13 0 0 0 -5,10" Stroke="{StaticResource ActivePurpleBrush}" StrokeThickness="1.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" RenderTransformOrigin="1.0,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>

