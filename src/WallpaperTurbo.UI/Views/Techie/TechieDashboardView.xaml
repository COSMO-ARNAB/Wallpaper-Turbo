                        <Grid x:Name="WavingHandContainer" Margin="10,0,0,0" VerticalAlignment="Center" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Arcs -->
                            <Grid Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0">
