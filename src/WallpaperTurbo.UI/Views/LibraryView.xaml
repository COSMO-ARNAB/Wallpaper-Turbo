<UserControl x:Class="WallpaperTurbo.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 1. Header Block -->
            <RowDefinition Height="Auto" />
            <!-- 2. Search & Category Filters -->
            <RowDefinition Height="Auto" />
            <!-- 3. Collection Grid (Scrollable) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Wallpaper Library Manager" Style="{StaticResource HeaderLargeStyle}" Margin="0,0,0,6" />
            <TextBlock Text="Browse your entire collection and click Play to launch any desktop wallpaper." FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <!-- 2. SEARCH & FILTER CONTROLS -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="All" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="All" 
                             IsChecked="True" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#1A1E2D" Foreground="#FFFFFF"/>
                <RadioButton Content="4K" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="4K" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                <RadioButton Content="Ultrawide" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="Ultrawide" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                <RadioButton Content="Abstract" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="Abstract" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                <RadioButton Content="Nature" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="Nature" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                <RadioButton Content="Sci-Fi" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="Sci-Fi" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <!-- Search box -->
            <ui:TextBox Grid.Column="1" 
                        PlaceholderText="Search wallpapers..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="Search24"
                        Height="32"
                        Background="#121622"
                        BorderBrush="#2066FCF1"
                        Foreground="#FFFFFF" />
        </Grid>

        <!-- 3. SIMPLE & STABLE ITEMS CONTROL -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredWallpapers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Premium media card with hover-reveal play overlay -->
                        <Border Margin="8" Width="230" Height="200" CornerRadius="10" Background="#131622" BorderBrush="#2066FCF1" BorderThickness="1" ClipToBounds="True" MouseLeftButtonDown="OnCardMouseLeftButtonDown" Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="136" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Thumbnail -->
                                <Image x:Name="CardThumb" Grid.Row="0" Source="{Binding LoadedThumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="115" CenterY="68" />
                                    </Image.RenderTransform>
                                </Image>

                                <!-- Hover scrim overlay -->
                                <Border x:Name="HoverScrim" Grid.Row="0" Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#CC060811" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Centered play button (neon-bordered hollow circle, hover reveal) -->
                                <Button x:Name="HoverPlayBtn"
                                        Grid.Row="0"
                                        Command="{Binding DataContext.PlayWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="44" Height="44"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Opacity="0"
                                        Panel.ZIndex="10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PlayRing"
                                                    Width="44" Height="44"
                                                    CornerRadius="22"
                                                    Background="#2566FCF1"
                                                    BorderBrush="{StaticResource ActiveCyanBrush}"
                                                    BorderThickness="1.5">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
                                                </Border.Effect>
                                                <ui:SymbolIcon x:Name="PlayIcon"
                                                               Symbol="Play16"
                                                               Foreground="{StaticResource ActiveCyanBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="14" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PlayRing" Property="Background" Value="{StaticResource ActiveCyanBrush}" />
                                                    <Setter TargetName="PlayIcon" Property="Foreground" Value="#060811" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="PlayRing" Property="Background" Value="#AAFCF1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Floating Trash delete button (premium hover reveal, top-right) -->
                                <Button x:Name="DeleteButton"
                                        Grid.Row="0"
                                        Command="{Binding DataContext.DeleteWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="26" Height="26"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="8"
                                        Panel.ZIndex="20">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="#CC1A1E2D" CornerRadius="13" BorderBrush="#50FF3366" BorderThickness="1">
                                                <ui:SymbolIcon x:Name="btnIcon" Symbol="Delete20" Foreground="#FF3366" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#FF3366" />
                                                    <Setter TargetName="btnIcon" Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsDeletable}" Value="True"/>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Card footer: title + resolution only (cleaner) -->
                                <Border Grid.Row="1" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Resolution}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <!-- Resolution tag pill -->
                                        <Border Grid.Column="1" Background="#15FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Fps}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource ActiveCyanBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Hover animations for the entire card -->
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScrim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="HoverPlayBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.25" />
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScrim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="HoverPlayBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
