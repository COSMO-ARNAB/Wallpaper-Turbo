<UserControl x:Class="WallpaperTurbo.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Library" Style="{StaticResource TitleStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Browse your collection and triple-click any card to play."
                       Style="{StaticResource SecondaryStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="All" Command="{Binding SelectCategoryCommand}" CommandParameter="All"
                             IsChecked="True" Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}" />
                <RadioButton Content="4K" Command="{Binding SelectCategoryCommand}" CommandParameter="4K"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Ultrawide" Command="{Binding SelectCategoryCommand}" CommandParameter="Ultrawide"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Abstract" Command="{Binding SelectCategoryCommand}" CommandParameter="Abstract"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Nature" Command="{Binding SelectCategoryCommand}" CommandParameter="Nature"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Sci-fi" Command="{Binding SelectCategoryCommand}" CommandParameter="Sci-Fi"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <ui:TextBox Grid.Column="1"
                        PlaceholderText="Search wallpapers…"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="Search24"
                        Style="{StaticResource Input}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredWallpapers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8" Width="230" Height="200" CornerRadius="{StaticResource RadiusMedium}" Style="{StaticResource Card}" ClipToBounds="True" MouseLeftButtonDown="OnCardMouseLeftButtonDown" Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="136" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Image x:Name="CardThumb" Grid.Row="0" Source="{Binding LoadedThumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <Border x:Name="HoverScrim" Grid.Row="0" Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#CC060811" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Button x:Name="HoverPlayBtn"
                                        Grid.Row="0"
                                        Command="{Binding DataContext.PlayWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="44" Height="44"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Opacity="0"
                                        Panel.ZIndex="10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PlayRing"
                                                    Width="44" Height="44"
                                                    CornerRadius="22"
                                                    Background="{StaticResource AccentBrush}">
                                                <ui:SymbolIcon x:Name="PlayIcon"
                                                               Symbol="Play16"
                                                               Foreground="{StaticResource Surface0Color}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="14" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PlayRing" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="DeleteButton"
                                        Grid.Row="0"
                                        Command="{Binding DataContext.DeleteWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="26" Height="26"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="8"
                                        Panel.ZIndex="20">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{StaticResource Surface2Brush}" CornerRadius="13" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                                                <ui:SymbolIcon x:Name="btnIcon" Symbol="Delete20" Foreground="{StaticResource StatusErrBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsDeletable}" Value="True" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Border Grid.Row="1" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="500" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Resolution}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Fps}" FontSize="10" FontWeight="600" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScrim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="HoverPlayBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScrim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="HoverPlayBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
