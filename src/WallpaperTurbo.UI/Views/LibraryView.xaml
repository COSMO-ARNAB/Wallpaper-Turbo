<UserControl x:Class="WallpaperTurbo.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 1. Header Block -->
            <RowDefinition Height="Auto" />
            <!-- 2. Search & Category Filters -->
            <RowDefinition Height="Auto" />
            <!-- 3. Collection Grid (Scrollable) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Wallpaper Library Manager" Style="{StaticResource HeaderLargeStyle}" Margin="0,0,0,6" />
            <TextBlock Text="Browse your entire collection and click Play to launch any desktop wallpaper." FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <!-- 2. SEARCH & FILTER CONTROLS -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="All" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="All" 
                             IsChecked="True" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#1A1E2D" Foreground="#FFFFFF"/>
                <RadioButton Content="4K" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="4K" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                <RadioButton Content="Ultrawide" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="Ultrawide" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                <RadioButton Content="Abstract" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="Abstract" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                <RadioButton Content="Nature" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="Nature" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                <RadioButton Content="Sci-Fi" 
                             Command="{Binding SelectCategoryCommand}" 
                             CommandParameter="Sci-Fi" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Height="30" Padding="14,3" Margin="0,0,8,0" 
                             Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <!-- Search box -->
            <ui:TextBox Grid.Column="1" 
                        PlaceholderText="Search wallpapers..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="Search24"
                        Height="32"
                        Background="#121622"
                        BorderBrush="#2066FCF1"
                        Foreground="#FFFFFF" />
        </Grid>

        <!-- 3. SIMPLE & STABLE ITEMS CONTROL -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredWallpapers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Simple, clean card -->
                        <Border Margin="8" Width="230" Height="200" CornerRadius="8" Background="#131622" BorderBrush="#2066FCF1" BorderThickness="1" ClipToBounds="True" MouseLeftButtonDown="OnCardMouseLeftButtonDown">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="124" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Thumbnail -->
                                <Image Grid.Row="0" Source="{Binding LoadedThumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                 <!-- Floating Trash delete button (premium hover reveal) -->
                                <Button x:Name="DeleteButton"
                                        Grid.Row="0"
                                        Command="{Binding DataContext.DeleteWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="28" Height="28"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="8">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="#FF3B30" CornerRadius="14" BorderThickness="0">
                                                <ui:SymbolIcon x:Name="btnIcon" Symbol="Delete20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="btnIcon" Property="Foreground" Value="#FF3B30" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsDeletable}" Value="True"/>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Metadata & Control footer -->
                                <Grid Grid.Row="1" Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Resolution}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" 
                                               Icon="Play16" 
                                               Command="{Binding DataContext.PlayWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                               CommandParameter="{Binding}" 
                                               Appearance="Primary" 
                                               Background="{StaticResource ActiveCyanBrush}" 
                                               Foreground="#000000"
                                               Width="32" Height="32" 
                                               CornerRadius="16" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
