<UserControl x:Class="WallpaperTurbo.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ROW 0: PAGE HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Dashboard"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand"
                    HorizontalAlignment="Left">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="BackArrow" Symbol="ArrowLeft24" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon.RenderTransform>
                                    <TranslateTransform X="0" />
                                </ui:SymbolIcon.RenderTransform>
                            </ui:SymbolIcon>
                            <TextBlock Text="Library" Style="{StaticResource TitleStyle}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackArrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="-4" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="Browse your collection and triple-click any card to play."
                       Style="{StaticResource SecondaryStyle}" Margin="30,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="All" Command="{Binding SelectCategoryCommand}" CommandParameter="All"
                             IsChecked="True" Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}" />
                <RadioButton Content="4K" Command="{Binding SelectCategoryCommand}" CommandParameter="4K"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Ultrawide" Command="{Binding SelectCategoryCommand}" CommandParameter="Ultrawide"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Abstract" Command="{Binding SelectCategoryCommand}" CommandParameter="Abstract"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Nature" Command="{Binding SelectCategoryCommand}" CommandParameter="Nature"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Sci-fi" Command="{Binding SelectCategoryCommand}" CommandParameter="Sci-Fi"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <ui:TextBox Grid.Column="1"
                        PlaceholderText="Search wallpapers…"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="Search24"
                        Style="{StaticResource Input}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredWallpapers}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" Margin="8" Width="230" Height="200" Padding="0" CornerRadius="{StaticResource RadiusMedium}" Style="{StaticResource Card}" ClipToBounds="True" MouseLeftButtonDown="OnCardMouseLeftButtonDown" Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="136" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Image x:Name="CardThumb" Grid.Row="0" Source="{Binding LoadedThumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                    </Image.RenderTransform>
                                </Image>

                                <Border x:Name="HoverScrim" Grid.Row="0" Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#CC060811" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Button x:Name="HoverPlayBtn"
                                        Grid.Row="0"
                                        Command="{Binding DataContext.PlayWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="44" Height="44"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5"
                                        Panel.ZIndex="10">
                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                                    </Button.RenderTransform>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PlayRing"
                                                    Width="44" Height="44"
                                                    CornerRadius="22"
                                                    Background="{StaticResource AccentBrush}"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0" />
                                                </Border.Effect>
                                                <ui:SymbolIcon x:Name="PlayIcon"
                                                               Symbol="Play16"
                                                               Foreground="{StaticResource Surface0Brush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               RenderTransformOrigin="0.5,0.5">
                                                    <ui:SymbolIcon.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                            <RotateTransform Angle="0" />
                                                        </TransformGroup>
                                                    </ui:SymbolIcon.RenderTransform>
                                                </ui:SymbolIcon>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PlayRing" Property="Background" Value="#00F5D4" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="PlayRing" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="PlayRing" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="PlayRing" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" To="0.9" Duration="0:0:0.18" />
                                                                <DoubleAnimation Storyboard.TargetName="PlayRing" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)" To="22" Duration="0:0:0.18" />
                                                                <DoubleAnimation Storyboard.TargetName="PlayIcon" Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.18" />
                                                                <DoubleAnimation Storyboard.TargetName="PlayIcon" Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.18" />
                                                                <DoubleAnimation Storyboard.TargetName="PlayIcon" Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)" To="15" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="PlayRing" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="PlayRing" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="PlayRing" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" To="0.0" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetName="PlayRing" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)" To="12" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetName="PlayIcon" Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetName="PlayIcon" Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetName="PlayIcon" Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)" To="0" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="DeleteButton"
                                        Grid.Row="0"
                                        Command="{Binding DataContext.DeleteWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="26" Height="26"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="8"
                                        Panel.ZIndex="20">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{StaticResource Surface2Brush}" CornerRadius="13" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                </Border.RenderTransform>
                                                <ui:SymbolIcon x:Name="btnIcon" Symbol="Delete20" Foreground="{StaticResource StatusErrBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" RenderTransformOrigin="0.5,0.5">
                                                    <ui:SymbolIcon.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </ui:SymbolIcon.RenderTransform>
                                                </ui:SymbolIcon>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#FF3366" />
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FF5588" />
                                                    <Setter TargetName="btnIcon" Property="Foreground" Value="White" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="btnIcon" Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(RotateTransform.Angle)" To="-15" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="btnIcon" Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsDeletable}" Value="True" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Border Grid.Row="1" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="500" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Resolution}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Fps}" FontSize="10" FontWeight="600" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverPlayBtn" Property="IsHitTestVisible" Value="True" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScrim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverPlayBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="HoverPlayBtn" Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverPlayBtn" Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScrim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverPlayBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="HoverPlayBtn" Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="0.6" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverPlayBtn" Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="0.6" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
