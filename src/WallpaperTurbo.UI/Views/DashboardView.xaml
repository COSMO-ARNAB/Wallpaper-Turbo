<UserControl x:Class="WallpaperTurbo.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:WallpaperTurbo.UI.Controls"
             xmlns:conv="clr-namespace:WallpaperTurbo.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <UserControl.Resources>
        <conv:ThumbnailImageConverter x:Key="ThumbnailConverter" />
        
        <!-- Premium ListBoxItem container styling to remove default selections -->
        <Style x:Key="PremiumCardContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- LEFT MAIN CONTENT REGION -->
        <!-- Grid row layout so ListBox gets a FINITE height → WPF virtualization works.
             ScrollViewer+StackPanel gives ListBox infinite height → ALL items rendered simultaneously. -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Featured header -->
                <RowDefinition Height="*" />     <!-- Hero/Featured Grid: fills remaining space! -->
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,8,0">
                
                <!-- FEATURED TITLE -->
                <TextBlock Text="Featured" Style="{StaticResource HeaderLargeStyle}" Margin="0,0,0,12" />
            </StackPanel>

            <!-- HERO DISPLAY GRID -->
            <Grid Grid.Row="1" Height="360" Margin="0,0,8,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Large Primary Hero Card -->
                <Border Grid.Column="0" Style="{StaticResource NeonCardStyle}" Margin="0,0,12,0" ClipToBounds="True" MouseLeftButtonDown="OnCardMouseLeftButtonDown" Tag="Hero">
                    <Grid>
                        <!-- Hero thumbnail: bound directly to LoadedThumbnail (async-loaded ImageSource, no converter) -->
                        <Image Source="{Binding HeroWallpaper.LoadedThumbnail}" 
                               Stretch="UniformToFill" 
                               x:Name="HeroBgImage"
                               Opacity="0.75" 
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="260" CenterY="180" />
                            </Image.RenderTransform>
                        </Image>
                        
                        <!-- Premium Cybernetic Dark Gradient Overlay for Typographical Contrast -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0.0" />
                                    <GradientStop Color="#80000000" Offset="0.5" />
                                    <GradientStop Color="#E00A0B10" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Cyber neon vectors overlay inside Hero Card -->
                        <Path Data="M 0,80 Q 200,20 400,60 T 800,20" 
                              Stroke="{StaticResource NeonPurpleCyanGradient}" 
                              StrokeThickness="1" 
                              Opacity="0.2"
                              VerticalAlignment="Center" 
                              HorizontalAlignment="Stretch" />

                        <!-- Details Overlay -->
                        <StackPanel VerticalAlignment="Bottom" Margin="24">
                            <TextBlock Text="FEATURED EXPERIENCE" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource ActiveCyanBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding HeroWallpaper.Title, FallbackValue='Astral Horizon'}" 
                                       FontSize="26" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding HeroWallpaper.Resolution, StringFormat={}{0} • 60 FPS • PRE-RENDERED, FallbackValue='3840 x 2160 • 60 FPS • PRE-RENDERED'}" 
                                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Play Overlay Button -->
                        <ui:Button Icon="Play24" 
                                   Command="{Binding PlayWallpaperCommand}" 
                                   CommandParameter="{Binding HeroWallpaper}"
                                   Appearance="Primary" 
                                   Foreground="#000000" 
                                   Background="{StaticResource ActiveCyanBrush}"
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Bottom" 
                                   Margin="24"
                                   Width="48" Height="48"
                                   CornerRadius="24">
                            <ui:Button.Effect>
                                <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="12" Opacity="0.5" ShadowDepth="0" />
                            </ui:Button.Effect>
                        </ui:Button>
                    </Grid>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HeroBgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.35" />
                                    <DoubleAnimation Storyboard.TargetName="HeroBgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.35" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HeroBgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.3" />
                                    <DoubleAnimation Storyboard.TargetName="HeroBgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>

                <!-- Small Right Stacked Cards -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Upper Sub Card (SubHero1) -->
                    <Border Grid.Row="0" Style="{StaticResource NeonCardStyle}" Margin="0,0,0,4" ClipToBounds="True" MouseLeftButtonDown="OnCardMouseLeftButtonDown" Tag="SubHero1">
                        <Grid>
                            <!-- Sub1 thumbnail bound to LoadedThumbnail -->
                            <Image Source="{Binding SubHero1.LoadedThumbnail}" 
                                   Stretch="UniformToFill" 
                                   x:Name="SubHero1BgImage"
                                   Opacity="0.6" 
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="130" CenterY="60" />
                                </Image.RenderTransform>
                            </Image>
                            
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#00000000" Offset="0.2" />
                                        <GradientStop Color="#C00A0B10" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" Margin="12">
                                <TextBlock Text="{Binding SubHero1.Title, FallbackValue='Retrowave Drive'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding SubHero1.Resolution, StringFormat={}{0} • 60 FPS, FallbackValue='3440 x 1440 • 60 FPS'}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>

                            <ui:Button Icon="Play16" Command="{Binding PlayWallpaperCommand}" CommandParameter="{Binding SubHero1}" Appearance="Secondary" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12" Width="32" Height="32" CornerRadius="16" />
                        </Grid>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SubHero1BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="SubHero1BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SubHero1BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="SubHero1BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>

                    <!-- Middle Sub Card (SubHero2) -->
                    <Border Grid.Row="1" Style="{StaticResource NeonCardStyle}" Margin="0,4,0,4" ClipToBounds="True" MouseLeftButtonDown="OnCardMouseLeftButtonDown" Tag="SubHero2">
                        <Grid>
                            <!-- Sub2 thumbnail bound to LoadedThumbnail -->
                            <Image Source="{Binding SubHero2.LoadedThumbnail}" 
                                   Stretch="UniformToFill" 
                                   x:Name="SubHero2BgImage"
                                   Opacity="0.6" 
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="130" CenterY="60" />
                                </Image.RenderTransform>
                            </Image>
                            
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#00000000" Offset="0.2" />
                                        <GradientStop Color="#C00A0B10" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" Margin="12">
                                <TextBlock Text="{Binding SubHero2.Title, FallbackValue='Forest Serenity'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding SubHero2.Resolution, StringFormat={}{0} • 30 FPS, FallbackValue='3840 x 2160 • 30 FPS'}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>

                            <ui:Button Icon="Play16" Command="{Binding PlayWallpaperCommand}" CommandParameter="{Binding SubHero2}" Appearance="Secondary" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12" Width="32" Height="32" CornerRadius="16" />
                        </Grid>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SubHero2BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="SubHero2BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SubHero2BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="SubHero2BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>

                    <!-- Lower Sub Card (SubHero3) -->
                    <Border Grid.Row="2" Style="{StaticResource NeonCardStyle}" Margin="0,4,0,0" ClipToBounds="True" MouseLeftButtonDown="OnCardMouseLeftButtonDown" Tag="SubHero3">
                        <Grid>
                            <!-- Sub3 thumbnail bound to LoadedThumbnail -->
                            <Image Source="{Binding SubHero3.LoadedThumbnail}" 
                                   Stretch="UniformToFill" 
                                   x:Name="SubHero3BgImage"
                                   Opacity="0.6" 
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="130" CenterY="60" />
                                </Image.RenderTransform>
                            </Image>
                            
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#00000000" Offset="0.2" />
                                        <GradientStop Color="#C00A0B10" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" Margin="12">
                                <TextBlock Text="{Binding SubHero3.Title, FallbackValue='Sukuna Madness'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding SubHero3.Resolution, StringFormat={}{0} • 60 FPS, FallbackValue='3840 x 2160 • 60 FPS'}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>

                            <ui:Button Icon="Play16" Command="{Binding PlayWallpaperCommand}" CommandParameter="{Binding SubHero3}" Appearance="Secondary" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12" Width="32" Height="32" CornerRadius="16" />
                        </Grid>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SubHero3BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="SubHero3BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SubHero3BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="SubHero3BgImage" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <!-- End Left Content Grid -->

        <!-- ========================================== -->
        <!-- RIGHT DIAGNOSTICS & TELEMETRY PANEL        -->
        <!-- ========================================== -->
        <Border Grid.Column="1" Background="#0C0E17" CornerRadius="16" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    
                    <!-- SYSTEM PERFORMANCE PANEL -->
                    <Border BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8" Background="#090A0E" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SYSTEM PERFORMANCE" Style="{StaticResource TelemetryLabelStyle}" Margin="0,0,0,12" />
                            
                            <!-- Circular Dial & Live Scrolling Telemetries -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Glowing Active Circular GPU Meter -->
                                <ctrl:TelemetryRing Grid.Column="0" Value="{Binding GpuValue}" />

                                <!-- Right Performance sparklines -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <!-- GPU 3D Graph -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="GPU 3D" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <ctrl:PerformanceGraph Grid.Column="1" Value="{Binding GpuValue}" StrokeBrush="{StaticResource ActiveCyanBrush}" GlowColor="{StaticResource ActiveCyanColor}" Height="12" />
                                    </Grid>

                                    <!-- Video Decode Graph -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Video Decode" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <ctrl:PerformanceGraph Grid.Column="1" Value="{Binding VideoDecodeValue}" StrokeBrush="{StaticResource ActivePurpleBrush}" GlowColor="{StaticResource ActivePurpleColor}" Height="12" />
                                    </Grid>

                                    <!-- CPU Graph -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CPU load" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <ctrl:PerformanceGraph Grid.Column="1" Value="{Binding CpuValue}" StrokeBrush="{StaticResource ActiveCyanBrush}" GlowColor="{StaticResource ActiveCyanColor}" Height="12" />
                                    </Grid>

                                    <!-- RAM usage -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="RAM usage" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <ctrl:PerformanceGraph Grid.Column="1" Value="{Binding RamPercentage}" StrokeBrush="{StaticResource ActivePurpleBrush}" GlowColor="{StaticResource ActivePurpleColor}" Height="12" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ENGINE STATUS PANEL -->
                    <Border BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8" Background="#090A0E" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ENGINE STATUS" Style="{StaticResource TelemetryLabelStyle}" Margin="0,0,0,12" />
                            <StackPanel>
                                <!-- Renderer -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Renderer" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding RendererText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                </Grid>
                                <!-- Hardware Decode -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Hardware Decode" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource ActiveGreenBrush}" Margin="0,2,6,0" />
                                        <TextBlock Text="{Binding HardwareDecodeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                                <!-- DWM Composition -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="DWM Composition" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource ActiveGreenBrush}" Margin="0,2,6,0" />
                                        <TextBlock Text="{Binding DwmCompositionText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                                <!-- WorkerW Attached -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="WorkerW Attached" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource ActiveGreenBrush}" Margin="0,2,6,0" />
                                        <TextBlock Text="{Binding WorkerWText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                                <!-- Frame Sync -->
                                <Grid Margin="0,0,0,0">
                                    <TextBlock Text="Frame Sync" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource ActiveGreenBrush}" Margin="0,2,6,0" />
                                        <TextBlock Text="{Binding FrameSyncText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- QUICK CONTROLS PANEL -->
                    <Border BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8" Background="#090A0E" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="QUICK CONTROLS" Style="{StaticResource TelemetryLabelStyle}" Margin="0,0,0,12" />
                            <StackPanel>
                                <ui:ToggleSwitch Content="Pause on Maximized" IsChecked="{Binding PauseOnMaximized}" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                                <ui:ToggleSwitch Content="Mute Audio" IsChecked="{Binding MuteAudio}" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                                <ui:ToggleSwitch Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                                <ui:ToggleSwitch Content="Auto Start Engine" IsChecked="{Binding AutoStartEngine}" Margin="0,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DISPLAY TOPOLOGY PANEL -->
                    <Border BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8" Background="#090A0E" Padding="12" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="DISPLAY TOPOLOGY" Style="{StaticResource TelemetryLabelStyle}" Margin="0,0,0,12" />
                            
                            <ItemsControl ItemsSource="{Binding Monitors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#2066FCF1" BorderThickness="1" CornerRadius="4" Background="#121625" Margin="4" Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Screen Bezel Mockup -->
                                                <Border Grid.Row="0" BorderBrush="#30FFFFFF" BorderThickness="2" CornerRadius="3" Height="62" Background="#0A0B10" ClipToBounds="True">
                                                    <Grid>
                                                        <!-- Glowing diagonal wireframe scanline -->
                                                        <Path Data="M -10,60 L 120,-10" Stroke="#1066FCF1" StrokeThickness="1"/>
                                                        
                                                        <!-- Monitor Number -->
                                                        <TextBlock Text="{Binding Number}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ActiveCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                 <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        
                                                        <!-- Resolution Overlay (Bottom Left) -->
                                                        <TextBlock Text="{Binding Resolution}" FontSize="7" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,2"/>
                                                        
                                                        <!-- Type Overlay (Top Right) -->
                                                        <TextBlock Text="{Binding Type}" FontSize="7" FontWeight="Bold" Foreground="{StaticResource ActivePurpleBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4,2"/>
                                                    </Grid>
                                                </Border>
                                                
                                                <!-- Monitor Stand Wireframe -->
                                                <Path Grid.Row="1" Data="M 35,0 L 32,10 L 48,10 L 45,0 Z M 15,10 L 65,10" 
                                                      Stroke="#25FFFFFF" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,2,0,0" Height="10" Width="80" Fill="#10FFFFFF"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- DEVELOPER DIAGNOSTICS & SANDBOX -->
                    <Border Visibility="{Binding DevOverlayVisibility}" BorderBrush="#25EA1B63" BorderThickness="1" CornerRadius="8" Background="#0C0E17" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <!-- Header with neon pink drop shadow effect -->
                            <TextBlock Text="DEVELOPER DIAGNOSTICS &amp; SANDBOX" FontSize="10" FontWeight="Bold" Foreground="#FF007F" Margin="0,0,0,12">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF007F" BlurRadius="4" ShadowDepth="0" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Diagnostics Counters -->
                            <StackPanel Margin="0,0,0,12">
                                <!-- Active Containers -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Active UI Containers" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Diagnostics.ActiveContainers}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                </Grid>
                                <!-- Loaded Thumbnails -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Loaded Thumbnails" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Diagnostics.ActiveBitmaps}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                </Grid>
                                <!-- Active Previews -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Active Preview Sessions" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Diagnostics.ActivePreviewSessions}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                </Grid>
                                <!-- Dispatcher Latency -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Dispatcher Latency" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Diagnostics.DispatcherLatency}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text=" ms" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <!-- Memory Usage -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Memory Profile" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Diagnostics.MemoryUsageText}" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                </Grid>
                                <!-- GPU Usage -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="GPU Load (Diagnostics)" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Diagnostics.GpuUsage, StringFormat={}{0:F1}%}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                </Grid>
                                <!-- Health Indicator -->
                                <Grid Margin="0,0,0,0">
                                    <TextBlock Text="Virtualization Health" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Margin="0,2,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Diagnostics.IsHealthy}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource ActiveGreenBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Diagnostics.IsHealthy}" Value="False">
                                                            <Setter Property="Fill" Value="#FF007F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#FFFFFF">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Diagnostics.IsHealthy}" Value="True">
                                                            <Setter Property="Text" Value="Healthy" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Diagnostics.IsHealthy}" Value="False">
                                                            <Setter Property="Text" Value="Warning" />
                                                            <Setter Property="Foreground" Value="#FF007F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Separator Background="#15FFFFFF" Margin="0,4,0,12" Height="1" />

                            <!-- Interactive Crash Isolation Toggles -->
                            <TextBlock Text="CRASH ISOLATION ACTIVE SWITCHES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                            <StackPanel>
                                <ui:ToggleSwitch Content="Enable Panel Virtualization" IsChecked="{Binding Diagnostics.EnableVirtualization, Mode=TwoWay}" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                                <ui:ToggleSwitch Content="Enable Async Thumbnails" IsChecked="{Binding Diagnostics.EnableAsyncThumbnailLoading, Mode=TwoWay}" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                                <ui:ToggleSwitch Content="Enable Hover Previews" IsChecked="{Binding Diagnostics.EnableHoverPreviews, Mode=TwoWay}" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                                <ui:ToggleSwitch Content="Enable Thumbnail Eviction" IsChecked="{Binding Diagnostics.EnableThumbnailEviction, Mode=TwoWay}" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                                <ui:ToggleSwitch Content="Enable Graph Interpolation" IsChecked="{Binding Diagnostics.EnableTelemetryInterpolation, Mode=TwoWay}" Margin="0,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
