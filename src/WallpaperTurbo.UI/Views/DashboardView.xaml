<UserControl x:Class="WallpaperTurbo.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:WallpaperTurbo.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT MAIN CONTENT REGION                   -->
        <!-- ========================================== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel Margin="0,0,8,0">
                
                <!-- FEATURED TITLE -->
                <TextBlock Text="Featured" Style="{StaticResource HeaderLargeStyle}" Margin="0,0,0,12" />

                <!-- HERO DISPLAY GRID -->
                <Grid Height="240" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Large Primary Hero Card -->
                    <Border Grid.Column="0" Style="{StaticResource NeonCardStyle}" Margin="0,0,12,0" ClipToBounds="True">
                        <Grid>
                            <!-- Ambient glowing placeholder visual matching 'Astral Horizon' -->
                            <Border CornerRadius="{StaticResource RadiusMedium}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0D0E15" Offset="0" />
                                        <GradientStop Color="#1A0D36" Offset="0.5" />
                                        <GradientStop Color="#0A1828" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            
                            <!-- Star Favoriting Icon (Glowing outline) -->
                            <ui:Button Icon="Star24" 
                                       Appearance="Transparent" 
                                       Foreground="{StaticResource ActiveCyanBrush}" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Top" 
                                       Margin="16" />

                            <!-- Glowing abstract neon vectors in center (to simulate wallpaper thumb premium vibe) -->
                            <Path Data="M 10,100 Q 100,20 200,80 T 300,10" 
                                  Stroke="{StaticResource NeonPurpleCyanGradient}" 
                                  StrokeThickness="1.5" 
                                  Opacity="0.4"
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Center" 
                                  Width="200" Height="100" />
                            
                            <!-- Details Overlay -->
                            <StackPanel VerticalAlignment="Bottom" Margin="24">
                                <TextBlock Text="{Binding HeroWallpaper.Title, FallbackValue='Astral Horizon'}" 
                                           FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding HeroWallpaper.Resolution, StringFormat={}{0} • 60 FPS • 4K, FallbackValue='3840 x 2160 • 60 FPS • 4K'}" 
                                           FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            
                            <!-- Play Overlay Button -->
                            <ui:Button Icon="Play24" 
                                       Command="{Binding PlayWallpaperCommand}" 
                                       CommandParameter="{Binding HeroWallpaper}"
                                       Appearance="Primary" 
                                       Foreground="#000000" 
                                       Background="{StaticResource ActiveCyanBrush}"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Width="48" Height="48"
                                       CornerRadius="24">
                                <ui:Button.Effect>
                                    <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="12" Opacity="0.4" ShadowDepth="0" />
                                </ui:Button.Effect>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!-- Small Right Stacked Cards -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Upper Sub Card -->
                        <Border Grid.Row="0" Style="{StaticResource NeonCardStyle}" Margin="0,0,0,6" ClipToBounds="True">
                            <Grid>
                                <ui:Button Icon="Star24" Appearance="Transparent" Foreground="{StaticResource ActiveCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
                                <StackPanel VerticalAlignment="Bottom" Margin="12">
                                    <TextBlock Text="{Binding SubHero1.Title, FallbackValue='Retrowave Drive'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding SubHero1.Resolution, StringFormat={}{0} • 60 FPS, FallbackValue='3440 x 1440 • 60 FPS'}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <ui:Button Icon="Play16" Command="{Binding PlayWallpaperCommand}" CommandParameter="{Binding SubHero1}" Appearance="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" CornerRadius="16" />
                            </Grid>
                        </Border>

                        <!-- Lower Sub Card -->
                        <Border Grid.Row="1" Style="{StaticResource NeonCardStyle}" Margin="0,6,0,0" ClipToBounds="True">
                            <Grid>
                                <ui:Button Icon="Star24" Appearance="Transparent" Foreground="{StaticResource ActiveCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
                                <StackPanel VerticalAlignment="Bottom" Margin="12">
                                    <TextBlock Text="{Binding SubHero2.Title, FallbackValue='Forest Serenity'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding SubHero2.Resolution, StringFormat={}{0} • 30 FPS, FallbackValue='3840 x 2160 • 30 FPS'}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <ui:Button Icon="Play16" Command="{Binding PlayWallpaperCommand}" CommandParameter="{Binding SubHero2}" Appearance="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" CornerRadius="16" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- LIBRARY REGION -->
                <TextBlock Text="Library" Style="{StaticResource HeaderLargeStyle}" Margin="0,0,0,8" />

                <!-- FILTERS & SEARCH ROW -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <!-- Filter Pill Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Content="All" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" Height="28" Padding="12,2" Margin="0,0,6,0" Background="#1A1E2D" Foreground="#FFFFFF"/>
                        <RadioButton Content="4K" Style="{StaticResource {x:Type ToggleButton}}" Height="28" Padding="12,2" Margin="0,0,6,0" Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                        <RadioButton Content="Ultrawide" Style="{StaticResource {x:Type ToggleButton}}" Height="28" Padding="12,2" Margin="0,0,6,0" Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                        <RadioButton Content="Abstract" Style="{StaticResource {x:Type ToggleButton}}" Height="28" Padding="12,2" Margin="0,0,6,0" Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                        <RadioButton Content="Nature" Style="{StaticResource {x:Type ToggleButton}}" Height="28" Padding="12,2" Margin="0,0,6,0" Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                        <RadioButton Content="Sci-Fi" Style="{StaticResource {x:Type ToggleButton}}" Height="28" Padding="12,2" Margin="0,0,6,0" Background="#10FFFFFF" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <!-- Premium Cybernetic Search Bar -->
                    <ui:TextBox Grid.Column="1" 
                                PlaceholderText="Search wallpapers..." 
                                Icon="Search24"
                                Height="30"
                                Background="#121622"
                                BorderBrush="#2066FCF1"
                                Foreground="#FFFFFF" />
                </Grid>

                <!-- STATIC FALLBACK GRID OF CARDS (MATCHES REFERENCE LAYOUT SYSTEM WITH ABSOLUTE RESPONSIVENESS) -->
                <UniformGrid Columns="4" VerticalAlignment="Top">
                    
                    <!-- Card 1 -->
                    <Border Style="{StaticResource NeonCardStyle}" Margin="4" Height="150" ClipToBounds="True">
                        <Grid>
                            <ui:Button Icon="Star16" Appearance="Transparent" Foreground="{StaticResource ActiveCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" />
                            <StackPanel VerticalAlignment="Bottom" Margin="10">
                                <TextBlock Text="Cosmic Drift" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="3840 x 2160 • 60 FPS" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <ui:Button Icon="Play16" Appearance="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" CornerRadius="15"/>
                        </Grid>
                    </Border>

                    <!-- Card 2 -->
                    <Border Style="{StaticResource NeonCardStyle}" Margin="4" Height="150" ClipToBounds="True">
                        <Grid>
                            <ui:Button Icon="Star16" Appearance="Transparent" Foreground="{StaticResource ActiveCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" />
                            <StackPanel VerticalAlignment="Bottom" Margin="10">
                                <TextBlock Text="Cyberpunk City" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="3440 x 1440 • 60 FPS" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <ui:Button Icon="Play16" Appearance="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" CornerRadius="15"/>
                        </Grid>
                    </Border>

                    <!-- Card 3 -->
                    <Border Style="{StaticResource NeonCardStyle}" Margin="4" Height="150" ClipToBounds="True">
                        <Grid>
                            <ui:Button Icon="Star16" Appearance="Transparent" Foreground="{StaticResource ActiveCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" />
                            <StackPanel VerticalAlignment="Bottom" Margin="10">
                                <TextBlock Text="Ocean Depths" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="3840 x 2160 • 30 FPS" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <ui:Button Icon="Play16" Appearance="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" CornerRadius="15"/>
                        </Grid>
                    </Border>

                    <!-- Card 4 -->
                    <Border Style="{StaticResource NeonCardStyle}" Margin="4" Height="150" ClipToBounds="True">
                        <Grid>
                            <ui:Button Icon="Star16" Appearance="Transparent" Foreground="{StaticResource ActiveCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" />
                            <StackPanel VerticalAlignment="Bottom" Margin="10">
                                <TextBlock Text="Minimal Waves" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="3840 x 2160 • 60 FPS" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <ui:Button Icon="Play16" Appearance="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" CornerRadius="15"/>
                        </Grid>
                    </Border>

                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- RIGHT DIAGNOSTICS & TELEMETRY PANEL        -->
        <!-- ========================================== -->
        <Border Grid.Column="1" Background="#0C0E17" CornerRadius="16" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    
                    <!-- SYSTEM PERFORMANCE PANEL -->
                    <Border BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8" Background="#090A0E" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SYSTEM PERFORMANCE" Style="{StaticResource TelemetryLabelStyle}" Margin="0,0,0,12" />
                            
                            <!-- Circular Dial & Live Scrolling Telemetries -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Glowing Active Circular GPU Meter -->
                                <ctrl:TelemetryRing Grid.Column="0" Value="{Binding GpuValue}" />

                                <!-- Right Performance sparklines -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <!-- GPU 3D Graph -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="GPU 3D" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <ctrl:PerformanceGraph Grid.Column="1" Value="{Binding GpuValue}" StrokeBrush="{StaticResource ActiveCyanBrush}" GlowColor="{StaticResource ActiveCyanColor}" Height="12" />
                                    </Grid>

                                    <!-- Video Decode Graph -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Video Decode" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <ctrl:PerformanceGraph Grid.Column="1" Value="{Binding VideoDecodeValue}" StrokeBrush="{StaticResource ActivePurpleBrush}" GlowColor="{StaticResource ActivePurpleColor}" Height="12" />
                                    </Grid>

                                    <!-- CPU Graph -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CPU load" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <ctrl:PerformanceGraph Grid.Column="1" Value="{Binding CpuValue}" StrokeBrush="{StaticResource ActiveCyanBrush}" GlowColor="{StaticResource ActiveCyanColor}" Height="12" />
                                    </Grid>

                                    <!-- RAM usage -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="RAM usage" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <ctrl:PerformanceGraph Grid.Column="1" Value="{Binding RamPercentage}" StrokeBrush="{StaticResource ActivePurpleBrush}" GlowColor="{StaticResource ActivePurpleColor}" Height="12" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ENGINE STATUS PANEL -->
                    <Border BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8" Background="#090A0E" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ENGINE STATUS" Style="{StaticResource TelemetryLabelStyle}" Margin="0,0,0,12" />
                            <StackPanel>
                                <!-- Renderer -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Renderer" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding RendererText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                </Grid>
                                <!-- Hardware Decode -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Hardware Decode" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource ActiveGreenBrush}" Margin="0,2,6,0" />
                                        <TextBlock Text="{Binding HardwareDecodeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                                <!-- DWM Composition -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="DWM Composition" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource ActiveGreenBrush}" Margin="0,2,6,0" />
                                        <TextBlock Text="{Binding DwmCompositionText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                                <!-- WorkerW Attached -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="WorkerW Attached" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource ActiveGreenBrush}" Margin="0,2,6,0" />
                                        <TextBlock Text="{Binding WorkerWText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                                <!-- Frame Sync -->
                                <Grid Margin="0,0,0,0">
                                    <TextBlock Text="Frame Sync" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource ActiveGreenBrush}" Margin="0,2,6,0" />
                                        <TextBlock Text="{Binding FrameSyncText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- QUICK CONTROLS PANEL -->
                    <Border BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8" Background="#090A0E" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="QUICK CONTROLS" Style="{StaticResource TelemetryLabelStyle}" Margin="0,0,0,12" />
                            <StackPanel>
                                <ui:ToggleSwitch Content="Pause on Maximized" IsChecked="{Binding PauseOnMaximized}" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                                <ui:ToggleSwitch Content="Mute Audio" IsChecked="{Binding MuteAudio}" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                                <ui:ToggleSwitch Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>
                                <ui:ToggleSwitch Content="Auto Start Engine" IsChecked="{Binding AutoStartEngine}" Margin="0,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DISPLAY TOPOLOGY PANEL -->
                    <Border BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8" Background="#090A0E" Padding="12" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="DISPLAY TOPOLOGY" Style="{StaticResource TelemetryLabelStyle}" Margin="0,0,0,12" />
                            
                            <ItemsControl ItemsSource="{Binding Monitors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#2066FCF1" BorderThickness="1" CornerRadius="4" Background="#121625" Margin="4" Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Screen Bezel Mockup -->
                                                <Border Grid.Row="0" BorderBrush="#30FFFFFF" BorderThickness="2" CornerRadius="3" Height="62" Background="#0A0B10" ClipToBounds="True">
                                                    <Grid>
                                                        <!-- Glowing diagonal wireframe scanline -->
                                                        <Path Data="M -10,60 L 120,-10" Stroke="#1066FCF1" StrokeThickness="1"/>
                                                        
                                                        <!-- Monitor Number -->
                                                        <TextBlock Text="{Binding Number}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ActiveCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect Color="{StaticResource ActiveCyanColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        
                                                        <!-- Resolution Overlay (Bottom Left) -->
                                                        <TextBlock Text="{Binding Resolution}" FontSize="7" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,2"/>
                                                        
                                                        <!-- Type Overlay (Top Right) -->
                                                        <TextBlock Text="{Binding Type}" FontSize="7" FontWeight="Bold" Foreground="{StaticResource ActivePurpleBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4,2"/>
                                                    </Grid>
                                                </Border>
                                                
                                                <!-- Monitor Stand Wireframe -->
                                                <Path Grid.Row="1" Data="M 35,0 L 32,10 L 48,10 L 45,0 Z M 15,10 L 65,10" 
                                                      Stroke="#25FFFFFF" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,2,0,0" Height="10" Width="80" Fill="#10FFFFFF"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
