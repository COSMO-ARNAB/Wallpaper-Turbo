<UserControl x:Class="WallpaperTurbo.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:WallpaperTurbo.UI.Controls"
             xmlns:conv="clr-namespace:WallpaperTurbo.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/GlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ThumbnailImageConverter x:Key="ThumbnailConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasWallpapers}" Value="True" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="0,0,0,8">

                <!-- CURRENT WALLPAPER HERO SECTION -->
                <TextBlock Text="Current Wallpaper"
                           Style="{StaticResource TitleStyle}"
                           Margin="0,0,0,12" />

                <Border Style="{StaticResource Card}"
                        Height="320"
                        Margin="0,0,0,28"
                        ClipToBounds="True"
                        MouseLeftButtonDown="OnCardMouseLeftButtonDown"
                        Tag="Hero">
                    <Grid>
                        <Image Source="{Binding CurrentWallpaper.Thumbnail, Converter={StaticResource ThumbnailConverter}, ConverterParameter=Hero}"
                               Stretch="UniformToFill"
                               x:Name="HeroBgImage"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Floating Glassmorphic Details Card -->
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="16"
                                Padding="16,12"
                                CornerRadius="12"
                                BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FFFFFF" Opacity="0.12" />
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#0E1118" Opacity="0.75" />
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.4" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentWallpaper.Title, FallbackValue='Evening Drive'}"
                                           FontSize="16"
                                           FontWeight="600"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           MaxWidth="400"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,4,0,0">
                                    <Run Text="{Binding CurrentWallpaper.Resolution, FallbackValue='3440 × 1440'}" /><Run Text=" · " /><Run Text="{Binding CurrentWallpaper.Fps, FallbackValue='60 FPS'}" /><Run Text=" · Pre-rendered" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- STATUS SECTION -->
                <TextBlock Text="Status"
                           Style="{StaticResource TitleStyle}"
                           Margin="0,0,0,12" />

                <UniformGrid Columns="4" Margin="0,0,0,28">
                    <!-- Card 1: Engine Status (Interactive Toggle Button) -->
                    <Button Command="{Binding DataContext.ToggleEngineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource CardButton}"
                            Padding="16,12"
                            Margin="0,0,8,0"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Height="Auto">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsEngineRunning, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource StatusOkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="13" FontWeight="600" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Engine: OFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsEngineRunning, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Text" Value="Engine: ON" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Card 2: measured AppRunner CPU -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="4,0,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Pulse24" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DataContext.Telemetry.CpuText, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='ENGINE CPU: {0}'}"
                                       FontSize="13" FontWeight="600" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: measured AppRunner GPU load -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="4,0,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash24" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DataContext.Telemetry.GpuText, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='ENGINE GPU: {0}'}"
                                       FontSize="13" FontWeight="600" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: measured AppRunner working set RAM -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Grid24" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DataContext.Telemetry.RamText, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='ENGINE RAM: {0}'}"
                                       FontSize="13" FontWeight="600" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- QUICK ACTIONS SECTION -->
                <TextBlock Text="Quick Actions"
                           Style="{StaticResource TitleStyle}"
                           Margin="0,0,0,12" />

                <UniformGrid Columns="3" Margin="0,0,0,28">
                    <Button Style="{StaticResource CardButton}" Margin="0,0,8,0"
                            Command="{Binding DataContext.ImportWallpaperCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Add24" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Import" Style="{StaticResource BodyStyle}" Margin="0,8,0,0" />
                            <TextBlock Text="Add .mp4, .webm, .mkv" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CardButton}" Margin="4,0,4,0">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Shuffle" Style="{StaticResource BodyStyle}" Margin="0,8,0,0" />
                            <TextBlock Text="Cycle through wallpapers" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CardButton}" Margin="8,0,0,0">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="List24" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="New Playlist" Style="{StaticResource BodyStyle}" Margin="0,8,0,0" />
                            <TextBlock Text="Group by mood or theme" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- RECENTLY USED SECTION -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Recently Used"
                               Style="{StaticResource TitleStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" 
                            Style="{StaticResource ButtonGhost}" 
                            Content="See all"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Library" />
                </Grid>

                <ListBox x:Name="RecentlyUsedListBox"
                         ItemsSource="{Binding RecentlyUsedWallpapers}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0,0,0,28"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         PreviewMouseWheel="OnRecentlyUsedMouseWheel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RecentCard"
                                    Width="200"
                                    Margin="0,0,12,0"
                                    Padding="0"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Style="{StaticResource Card}"
                                    ClipToBounds="True"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="130" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- ROW 0: Thumbnail + overlay -->
                                    <Grid Grid.Row="0">
                                        <Image x:Name="RecentThumb"
                                               Source="{Binding LoadedThumbnail}"
                                               Stretch="UniformToFill"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                            </Image.RenderTransform>
                                        </Image>

                                        <!-- Gradient scrim -->
                                        <Border Height="70" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#00000000" Offset="0" />
                                                    <GradientStop Color="#C80A0B0E" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Title + resolution overlay -->
                                        <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,8">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="600"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Resolution}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Active "LIVE" indicator dot — top left -->
                                        <Border x:Name="ActiveDot"
                                                Width="8" Height="8"
                                                CornerRadius="4"
                                                Background="#22C55E"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Opacity="0"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#22C55E" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                                            </Border.Effect>
                                        </Border>
                                    </Grid>

                                    <!-- ROW 1: Live Swap pill button -->
                                    <Button x:Name="LiveSwapBtn"
                                            Grid.Row="1"
                                            Command="{Binding DataContext.PlayWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Tag="{Binding IsActive}"
                                            Margin="8,6,8,8"
                                            Height="28"
                                            Cursor="Hand"
                                            HorizontalAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="PillBorder"
                                                        CornerRadius="14"
                                                        BorderThickness="1"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#0D1A1F" />
                                                    </Border.Background>
                                                    <Border.BorderBrush>
                                                        <SolidColorBrush x:Name="PillStroke" Color="#00F5D4" Opacity="0.35" />
                                                    </Border.BorderBrush>
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect x:Name="PillGlow"
                                                                          Color="#00F5D4"
                                                                          BlurRadius="0"
                                                                          ShadowDepth="0"
                                                                          Opacity="0" />
                                                    </Border.Effect>

                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <ui:SymbolIcon x:Name="SwapIcon"
                                                                       Symbol="ArrowSync20"
                                                                       FontSize="12"
                                                                       Foreground="#00F5D4"
                                                                       Margin="0,0,5,0"
                                                                       VerticalAlignment="Center"
                                                                       RenderTransformOrigin="0.5,0.5">
                                                            <ui:SymbolIcon.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </ui:SymbolIcon.RenderTransform>
                                                        </ui:SymbolIcon>
                                                        <TextBlock x:Name="PillLabel"
                                                                   Text="Live Swap"
                                                                   FontSize="11"
                                                                   FontWeight="600"
                                                                   Foreground="#00F5D4"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <!-- Hover: glow + icon spin + pill scale -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="PillBorder" Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#12292F" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="PillBorder"
                                                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.03" Duration="0:0:0.18">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="PillBorder"
                                                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.03" Duration="0:0:0.18">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="PillGlow"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0.7" Duration="0:0:0.2" />
                                                                    <DoubleAnimation Storyboard.TargetName="PillGlow"
                                                                                     Storyboard.TargetProperty="BlurRadius"
                                                                                     To="10" Duration="0:0:0.2" />
                                                                    <DoubleAnimation Storyboard.TargetName="SwapIcon"
                                                                                     Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(RotateTransform.Angle)"
                                                                                     To="360" Duration="0:0:0.45">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseInOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="PillBorder"
                                                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.0" Duration="0:0:0.2" />
                                                                    <DoubleAnimation Storyboard.TargetName="PillBorder"
                                                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.0" Duration="0:0:0.2" />
                                                                    <DoubleAnimation Storyboard.TargetName="PillGlow"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0" Duration="0:0:0.2" />
                                                                    <DoubleAnimation Storyboard.TargetName="PillGlow"
                                                                                     Storyboard.TargetProperty="BlurRadius"
                                                                                     To="0" Duration="0:0:0.2" />
                                                                    <DoubleAnimation Storyboard.TargetName="SwapIcon"
                                                                                     Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(RotateTransform.Angle)"
                                                                                     To="0" Duration="0:0:0.0" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>

                                                    <!-- Pressed: flash opacity -->
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="PillBorder" Property="Opacity" Value="0.6" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                                        <Setter TargetName="SwapIcon" Property="Symbol" Value="Play20" />
                                                        <Setter TargetName="PillLabel" Property="Text" Value="Apply" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- DataTemplate triggers: card hover zoom + active state dot -->
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RecentThumb"
                                                                 Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.07" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="RecentThumb"
                                                                 Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.07" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RecentThumb"
                                                                 Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.0" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="RecentThumb"
                                                                 Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.0" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>

                            <!-- DataTrigger for IsActive green dot (outside Border so it can use DataTemplate scope) -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="ActiveDot" Property="Opacity" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- PLAYLISTS SECTION -->
                <TextBlock Text="Playlists"
                           Style="{StaticResource TitleStyle}"
                           Margin="0,0,0,12" />

                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <Border Style="{StaticResource CardHover}" Height="72" Margin="0,0,8,0" Padding="14" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Anime" Style="{StaticResource BodyStyle}" />
                            <TextBlock Text="18 wallpapers" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardHover}" Height="72" Margin="4,0,4,0" Padding="14" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Nature" Style="{StaticResource BodyStyle}" />
                            <TextBlock Text="12 wallpapers" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardHover}" Height="72" Margin="8,0,0,0" Padding="14" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cyberpunk" Style="{StaticResource BodyStyle}" />
                            <TextBlock Text="31 wallpapers" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- EMPTY STATE PANEL -->
        <Border Margin="0,0,8,24" VerticalAlignment="Top" Padding="40">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasWallpapers}" Value="False" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding DataContext.ImportWallpaperCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,16" Cursor="Hand" Focusable="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CircularBorder" Width="72" Height="72" CornerRadius="36"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <ui:SymbolIcon x:Name="Icon" Symbol="Add24" FontSize="32" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderTransformOrigin="0.5,0.5">
                                    <ui:SymbolIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </ui:SymbolIcon.RenderTransform>
                                </ui:SymbolIcon>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CircularBorder" Property="Background" Value="{StaticResource Surface3Brush}" />
                                    <Setter TargetName="CircularBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CircularBorder"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.08" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="CircularBorder"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.08" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 To="90" Duration="0:0:0.25" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CircularBorder"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="CircularBorder"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 To="0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CircularBorder" Property="Background" Value="{StaticResource Surface1Brush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="Import your first wallpaper"
                           Style="{StaticResource TitleStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Text="Bring your desktop to life with high-fidelity videos. .mp4, .webm, and .mkv supported."
                           Style="{StaticResource SecondaryStyle}"
                           MaxWidth="380"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
