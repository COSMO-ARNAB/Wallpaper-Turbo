<UserControl x:Class="WallpaperTurbo.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:WallpaperTurbo.UI.Controls"
             xmlns:conv="clr-namespace:WallpaperTurbo.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:ThumbnailImageConverter x:Key="ThumbnailConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasWallpapers}" Value="True" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="0,0,0,8">

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{Binding GreetingHeader, FallbackValue='Good Evening 👋'}"
                               Style="{StaticResource DisplayStyle}" />
                    <TextBlock Text="{Binding GreetingSubtext, FallbackValue='Your engine is running smoothly.'}"
                               Style="{StaticResource SecondaryStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Style="{StaticResource Card}"
                        Height="320"
                        Margin="0,0,0,28"
                        ClipToBounds="True"
                        MouseLeftButtonDown="OnCardMouseLeftButtonDown"
                        Tag="Hero">
                    <Grid>
                        <Image Source="{Binding CurrentWallpaper.Thumbnail, Converter={StaticResource ThumbnailConverter}, ConverterParameter=Hero}"
                               Stretch="UniformToFill"
                               x:Name="HeroBgImage"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <Border Style="{StaticResource CardTitleStrip}">
                            <Border.Effect>
                                <BlurEffect Radius="20" />
                            </Border.Effect>
                        </Border>

                        <StackPanel VerticalAlignment="Bottom" Margin="24,16">
                            <TextBlock Text="{Binding CurrentWallpaper.Title, FallbackValue='Evening Drive'}"
                                       FontSize="22"
                                       FontWeight="600"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentWallpaper.Resolution, StringFormat={}{0} · 60 FPS · Pre-rendered, FallbackValue='3440 × 1440 · 60 FPS · Pre-rendered'}"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Quick access"
                               Style="{StaticResource TitleStyle}"
                               VerticalAlignment="Center" />
                </Grid>

                <UniformGrid Columns="4" Margin="0,0,0,28">
                    <Button Style="{StaticResource CardButton}" Margin="0,0,8,0"
                            Command="{Binding DataContext.ImportWallpaperCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Add24" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Import wallpaper" Style="{StaticResource BodyStyle}" Margin="0,8,0,0" />
                            <TextBlock Text="Add .mp4, .webm, .mkv" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CardButton}" Margin="4,0,4,0">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Shuffle library" Style="{StaticResource BodyStyle}" Margin="0,8,0,0" />
                            <TextBlock Text="Cycle through wallpapers" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CardButton}" Margin="4,0,4,0">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="List24" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="New playlist" Style="{StaticResource BodyStyle}" Margin="0,8,0,0" />
                            <TextBlock Text="Group by mood or theme" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CardButton}" Margin="8,0,0,0">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="More" Style="{StaticResource BodyStyle}" Margin="0,8,0,0" />
                            <TextBlock Text="All quick actions" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Continue watching"
                               Style="{StaticResource TitleStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource ButtonGhost}" Content="See all" />
                </Grid>

                <ListBox x:Name="RecentlyUsedListBox"
                         ItemsSource="{Binding RecentlyUsedWallpapers}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0,0,0,28"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="130" Margin="0,0,12,0" CornerRadius="{StaticResource RadiusMedium}" Style="{StaticResource Card}" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="OnCardMouseLeftButtonDown">
                                <Grid>
                                    <Image Source="{Binding LoadedThumbnail}" Stretch="UniformToFill" />
                                    <Border Height="60" VerticalAlignment="Bottom">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#AA0A0B0E" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom" Margin="12,8">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="500" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Resolution, StringFormat={}{0} · 60 FPS}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Playlists"
                           Style="{StaticResource TitleStyle}"
                           Margin="0,0,0,12" />

                <UniformGrid Columns="4" Margin="0,0,0,8">
                    <Border Style="{StaticResource CardHover}" Height="72" Margin="0,0,8,0" Padding="14" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Favorites" Style="{StaticResource BodyStyle}" />
                            <TextBlock Text="24 wallpapers" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardHover}" Height="72" Margin="4,0,4,0" Padding="14" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Anime vibes" Style="{StaticResource BodyStyle}" />
                            <TextBlock Text="18 wallpapers" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardHover}" Height="72" Margin="4,0,4,0" Padding="14" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cars &amp; drives" Style="{StaticResource BodyStyle}" />
                            <TextBlock Text="12 wallpapers" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardHover}" Height="72" Margin="8,0,0,0" Padding="14" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Dark aesthetic" Style="{StaticResource BodyStyle}" />
                            <TextBlock Text="31 wallpapers" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <Border Margin="0,0,8,24" VerticalAlignment="Top" Padding="40">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasWallpapers}" Value="False" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <ui:SymbolIcon Symbol="Add24" FontSize="32" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Import your first wallpaper"
                           Style="{StaticResource TitleStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Text="Bring your desktop to life with high-fidelity videos. .mp4, .webm, and .mkv supported."
                           Style="{StaticResource SecondaryStyle}"
                           MaxWidth="380"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />
                <Button Content="Import wallpaper"
                        Command="{Binding DataContext.ImportWallpaperCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource ButtonPrimary}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
