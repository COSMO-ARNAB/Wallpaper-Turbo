<UserControl x:Class="WallpaperTurbo.UI.Views.Minimal.MinimalLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Theme/GlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <!-- ROW 0: PAGE HEADER -->
            <RowDefinition Height="Auto" />
            <!-- ROW 1: NOW PLAYING BENTO BANNER -->
            <RowDefinition Height="Auto" />
            <!-- ROW 2: FILTERS & SEARCH -->
            <RowDefinition Height="Auto" />
            <!-- ROW 3: MY COLLECTION GRID -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: PAGE HEADER                         -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Dashboard"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand"
                        HorizontalAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="BackArrow" Symbol="ArrowLeft24" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </ui:SymbolIcon.RenderTransform>
                                </ui:SymbolIcon>
                                <TextBlock Text="Wallpaper Library" Style="{StaticResource TitleStyle}" FontSize="24" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BackArrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="-4" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="Manage, explore, and hot-swap your desktop canvases instantly."
                           Style="{StaticResource SecondaryStyle}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="30,4,0,0" />
            </StackPanel>

            <!-- Import Button -->
            <ui:Button Grid.Column="1"
                    Content="Import Media"
                    Icon="Add24"
                    Command="{Binding ImportWallpaperCommand}"
                    Appearance="Primary"
                    Height="36"
                    Padding="16,0"
                    VerticalAlignment="Center"
                    CornerRadius="8" />
        </Grid>

        <!-- ========================================== -->
        <!-- ROW 1: NOW PLAYING BENTO BANNER            -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <!-- Active Wallpaper State -->
            <Border CornerRadius="16" 
                    Padding="20,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveWallpaper}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="#00F5D4" BlurRadius="20" ShadowDepth="0" Opacity="0.08" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Preview Thumbnail -->
                    <Border Grid.Column="0" Width="240" Height="135" CornerRadius="10" ClipToBounds="True" BorderThickness="1" BorderBrush="#15FFFFFF">
                        <Grid>
                            <Image Source="{Binding ActiveWallpaper.LoadedThumbnail}" Stretch="UniformToFill" />
                            
                            <!-- Glowing Active live badge -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4" CornerRadius="6" Background="#B00F172A">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.8" AutoReverse="True" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="NOW PLAYING" FontSize="9" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Details Area -->
                    <StackPanel Grid.Column="1" Margin="24,4,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveWallpaper.Title}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Background="#10FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding ActiveWallpaper.Resolution}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="#10FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding ActiveWallpaper.Fps}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="{Binding ActiveWallpaper.Author, StringFormat='by {0}'}" FontSize="12.5" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Engine is running smoothly in hardware composition mode." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" Opacity="0.8" />
                    </StackPanel>

                    <!-- Large Play/Pause Toggle -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button ToolTip="Pause / Play"
                                   Command="{Binding DataContext.ToggleEngineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Width="44" Height="44" CornerRadius="22" Margin="0,0,12,0"
                                   Appearance="Transparent">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ui:SymbolIcon Symbol="Play24" FontSize="20" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <ui:SymbolIcon Symbol="Pause24" FontSize="20" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button ToolTip="Open file location"
                                   Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding ActiveWallpaper}"
                                   Width="44" Height="44" CornerRadius="22"
                                   Appearance="Transparent"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="20" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- No Active Wallpaper Empty State Banner -->
            <Border CornerRadius="16" 
                    Padding="20,24">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveWallpaper}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#10FFFFFF" Margin="0,0,16,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Flash24" Foreground="{StaticResource TextTertiaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="No active wallpaper on desktop" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Choose any item from your collection below and click Live Swap to bring your display to life." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- ROW 2: FILTERS & SEARCH                    -->
        <!-- ========================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Modern Pill Filters -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="All Collections" Command="{Binding SelectCategoryCommand}" CommandParameter="All"
                             IsChecked="True" Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}" />
                <RadioButton Content="4K Ultra" Command="{Binding SelectCategoryCommand}" CommandParameter="4K"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Ultrawide" Command="{Binding SelectCategoryCommand}" CommandParameter="Ultrawide"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Abstract" Command="{Binding SelectCategoryCommand}" CommandParameter="Abstract"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Sci-fi" Command="{Binding SelectCategoryCommand}" CommandParameter="Sci-Fi"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton Content="Nature" Command="{Binding SelectCategoryCommand}" CommandParameter="Nature"
                             Height="32" Padding="14,4" Margin="0,0,8,0"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Search box -->
            <ui:TextBox Grid.Column="1"
                        PlaceholderText="Filter collection..."
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="Search24"
                        Style="{StaticResource Input}"
                        Height="32" />
        </Grid>

        <!-- ========================================== -->
        <!-- ROW 3: MY COLLECTION GRID                  -->
        <!-- ========================================== -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredWallpapers}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Grid Card Container -->
                        <Border x:Name="CardBorder" Margin="10,10,10,12" Width="230" Height="215" CornerRadius="14" Style="{StaticResource Card}" ClipToBounds="True" MouseLeftButtonDown="OnCardMouseLeftButtonDown" Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="130" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Thumbnail Image -->
                                <Grid Grid.Row="0" ClipToBounds="True">
                                    <Image x:Name="CardThumb" Source="{Binding LoadedThumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                        </Image.RenderTransform>
                                    </Image>
                                    
                                    <!-- Hover Scrim overlay -->
                                    <Border x:Name="HoverScrim" Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#CC060811" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    
                                    <!-- Active Green Indicator Dot (with shadow glow) in top-left -->
                                    <Border x:Name="ActiveDot" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Width="10" Height="10" CornerRadius="5" Background="#22C55E" Visibility="Collapsed">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#22C55E" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                                        </Border.Effect>
                                    </Border>

                                    <!-- Delete Button (Only visible on hover) -->
                                    <Button x:Name="DeleteButton"
                                            Command="{Binding DataContext.DeleteWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="8"
                                            Panel.ZIndex="20">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="#B00F172A" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                    </Border.RenderTransform>
                                                    <ui:SymbolIcon x:Name="btnIcon" Symbol="Delete20" Foreground="{StaticResource StatusErrBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                        <ui:SymbolIcon.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </ui:SymbolIcon.RenderTransform>
                                                    </ui:SymbolIcon>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#FF3366" />
                                                        <Setter TargetName="btnIcon" Property="Foreground" Value="White" />
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.12" />
                                                                    <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.12" />
                                                                    <DoubleAnimation Storyboard.TargetName="btnIcon" Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(RotateTransform.Angle)" To="-10" Duration="0:0:0.12" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15" />
                                                                    <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15" />
                                                                    <DoubleAnimation Storyboard.TargetName="btnIcon" Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.15" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDeletable}" Value="True" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Bottom Info & Swapper Area -->
                                <Border Grid.Row="1" Padding="10,8">
                                    <Grid>
                                        <!-- Default State: Details Panel -->
                                        <Grid x:Name="DetailsPanel">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Resolution}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#15FFFFFF" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Fps, StringFormat='{}{0}F'}" FontSize="9.5" FontWeight="600" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                        </Grid>

                                         <!-- Hover State: Brand New Live Swap Pill Button -->
                                         <Button x:Name="LiveSwapPill"
                                                 Command="{Binding DataContext.PlayWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"
                                                 Tag="{Binding IsActive}"
                                                 Height="30"
                                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                 Opacity="0" IsHitTestVisible="False"
                                                 RenderTransformOrigin="0.5,0.5">
                                             <Button.RenderTransform>
                                                 <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                             </Button.RenderTransform>
                                             <Button.Template>
                                                 <ControlTemplate TargetType="Button">
                                                     <Border x:Name="PillBorder"
                                                             CornerRadius="15"
                                                             BorderThickness="1"
                                                             RenderTransformOrigin="0.5,0.5">
                                                         <Border.Background>
                                                             <SolidColorBrush Color="#0D1A1F" />
                                                         </Border.Background>
                                                         <Border.BorderBrush>
                                                             <SolidColorBrush x:Name="PillStroke" Color="#00F5D4" Opacity="0.35" />
                                                         </Border.BorderBrush>
                                                         <Border.RenderTransform>
                                                             <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                         </Border.RenderTransform>
                                                         <Border.Effect>
                                                             <DropShadowEffect x:Name="PillGlow"
                                                                               Color="#00F5D4"
                                                                               BlurRadius="0"
                                                                               ShadowDepth="0"
                                                                               Opacity="0" />
                                                         </Border.Effect>
                                                         <StackPanel Orientation="Horizontal"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center">
                                                             <ui:SymbolIcon x:Name="SwapIcon"
                                                                            Symbol="ArrowSync20"
                                                                            FontSize="12"
                                                                            Foreground="#00F5D4"
                                                                            Margin="0,0,5,0"
                                                                            VerticalAlignment="Center"
                                                                            RenderTransformOrigin="0.5,0.5">
                                                                 <ui:SymbolIcon.RenderTransform>
                                                                     <RotateTransform Angle="0" />
                                                                 </ui:SymbolIcon.RenderTransform>
                                                             </ui:SymbolIcon>
                                                             <TextBlock x:Name="PillLabel"
                                                                        Text="Live Swap"
                                                                        FontSize="11"
                                                                        FontWeight="600"
                                                                        Foreground="#00F5D4"
                                                                        VerticalAlignment="Center" />
                                                         </StackPanel>
                                                     </Border>
                                                     <ControlTemplate.Triggers>
                                                         <Trigger Property="IsMouseOver" Value="True">
                                                             <Setter TargetName="PillBorder" Property="Background">
                                                                 <Setter.Value>
                                                                     <SolidColorBrush Color="#12292F" />
                                                                 </Setter.Value>
                                                             </Setter>
                                                             <Trigger.EnterActions>
                                                                 <BeginStoryboard>
                                                                     <Storyboard>
                                                                         <DoubleAnimation Storyboard.TargetName="PillBorder"
                                                                                          Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                          To="1.03" Duration="0:0:0.18">
                                                                             <DoubleAnimation.EasingFunction>
                                                                                 <QuadraticEase EasingMode="EaseOut" />
                                                                             </DoubleAnimation.EasingFunction>
                                                                         </DoubleAnimation>
                                                                         <DoubleAnimation Storyboard.TargetName="PillBorder"
                                                                                          Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                          To="1.03" Duration="0:0:0.18">
                                                                             <DoubleAnimation.EasingFunction>
                                                                                 <QuadraticEase EasingMode="EaseOut" />
                                                                             </DoubleAnimation.EasingFunction>
                                                                         </DoubleAnimation>
                                                                         <DoubleAnimation Storyboard.TargetName="PillGlow"
                                                                                          Storyboard.TargetProperty="Opacity"
                                                                                          To="0.7" Duration="0:0:0.2" />
                                                                         <DoubleAnimation Storyboard.TargetName="PillGlow"
                                                                                          Storyboard.TargetProperty="BlurRadius"
                                                                                          To="10" Duration="0:0:0.2" />
                                                                         <DoubleAnimation Storyboard.TargetName="SwapIcon"
                                                                                          Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(RotateTransform.Angle)"
                                                                                          To="360" Duration="0:0:0.45">
                                                                             <DoubleAnimation.EasingFunction>
                                                                                 <QuadraticEase EasingMode="EaseInOut" />
                                                                             </DoubleAnimation.EasingFunction>
                                                                         </DoubleAnimation>
                                                                     </Storyboard>
                                                                 </BeginStoryboard>
                                                             </Trigger.EnterActions>
                                                             <Trigger.ExitActions>
                                                                 <BeginStoryboard>
                                                                     <Storyboard>
                                                                         <DoubleAnimation Storyboard.TargetName="PillBorder"
                                                                                          Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                          To="1.0" Duration="0:0:0.2" />
                                                                         <DoubleAnimation Storyboard.TargetName="PillBorder"
                                                                                          Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                          To="1.0" Duration="0:0:0.2" />
                                                                         <DoubleAnimation Storyboard.TargetName="PillGlow"
                                                                                          Storyboard.TargetProperty="Opacity"
                                                                                          To="0" Duration="0:0:0.2" />
                                                                         <DoubleAnimation Storyboard.TargetName="PillGlow"
                                                                                          Storyboard.TargetProperty="BlurRadius"
                                                                                          To="0" Duration="0:0:0.2" />
                                                                         <DoubleAnimation Storyboard.TargetName="SwapIcon"
                                                                                          Storyboard.TargetProperty="(ui:SymbolIcon.RenderTransform).(RotateTransform.Angle)"
                                                                                          To="0" Duration="0:0:0.0" />
                                                                     </Storyboard>
                                                                 </BeginStoryboard>
                                                             </Trigger.ExitActions>
                                                         </Trigger>
                                                         <Trigger Property="IsPressed" Value="True">
                                                             <Setter TargetName="PillBorder" Property="Opacity" Value="0.6" />
                                                         </Trigger>
                                                         <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                                             <Setter TargetName="SwapIcon" Property="Symbol" Value="Play20" />
                                                             <Setter TargetName="PillLabel" Property="Text" Value="Apply" />
                                                         </DataTrigger>
                                                     </ControlTemplate.Triggers>
                                                 </ControlTemplate>
                                             </Button.Template>
                                         </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- DataTrigger for IsActive green dot (scoped properly to the item) -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- Hover Animation Triggers on Card -->
                            <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="LiveSwapPill" Property="IsHitTestVisible" Value="True" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Card image scales smoothly to 1.05 -->
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverScrim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                            
                                            <!-- Switch card details with Live Swap pill button -->
                                            <DoubleAnimation Storyboard.TargetName="DetailsPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="LiveSwapPill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="LiveSwapPill" Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LiveSwapPill" Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="CardThumb" Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="HoverScrim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            
                                            <!-- Restore card details panel -->
                                            <DoubleAnimation Storyboard.TargetName="DetailsPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="LiveSwapPill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="LiveSwapPill" Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="0.9" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="LiveSwapPill" Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
