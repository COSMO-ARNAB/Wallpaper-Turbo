<UserControl x:Class="WallpaperTurbo.UI.Views.Minimal.MinimalLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:WallpaperTurbo.UI"
             xmlns:views="clr-namespace:WallpaperTurbo.UI.Views"
             xmlns:vm="clr-namespace:WallpaperTurbo.UI.ViewModels"
             xmlns:models="clr-namespace:WallpaperTurbo.UI.Models"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1240">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Theme/GlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <!-- FIX: Background MUST live in a Style Setter, never as a local value.
                     A local <Grid.Background> property value is auto-frozen by WPF at
                     visual-tree load time — any DataTrigger Setter that tries to modify
                     a frozen brush silently fails, keeping the background permanently opaque. -->
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#11141B" Offset="0" />
                            <GradientStop Color="#0A0B0E" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="8" />
                    </DataTrigger>

                    <!-- Glass mode: Transparent Grid background to let DWM backdrop show through -->
                    <DataTrigger Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Dynamic glass background tint overlay border at bottom of Z-order -->
        <Border Grid.RowSpan="3"
                Background="#0D0F15"
                Opacity="{Binding DataContext.Presentation.OverlayOpacity, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />

        <!-- ROW 0: TOP HEADER -->
        <Grid Grid.Row="0" Height="56">
            <Border Padding="24,8" Height="56" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <!-- Clickable Brand Logo & Title -->
                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="Dashboard"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/Branding/wallpaper-turbo.png"
                                           Width="28" Height="28"
                                           Margin="0,0,10,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Wallpaper Turbo"
                                                   FontSize="14"
                                                   FontWeight="600"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Live desktop engine"
                                                   FontSize="10"
                                                   FontWeight="500"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Top-Right Action Buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,140,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ButtonGhost}"
                                ToolTip="Switch to Techie Layout"
                                Command="{Binding LayoutHost.SwitchLayoutCommand}"
                                CommandParameter="{x:Static models:LayoutMode.Techie}"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <ui:SymbolIcon Symbol="Grid24" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource ButtonGhost}"
                                ToolTip="Notifications"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <ui:SymbolIcon Symbol="Alert24" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource ButtonGhost}"
                                ToolTip="Settings"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Settings"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Margin="4,0,0,0">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                        </Button>
                        <Border Width="28" Height="28"
                                CornerRadius="14"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ui:TitleBar Title="" Height="56" HorizontalAlignment="Right" Width="140" VerticalAlignment="Stretch" Padding="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <!-- ROW 1: UPDATE NOTIFICATION BANNER -->
        <Border Grid.Row="1"
                Margin="24,8,24,0"
                Padding="16,12"
                Style="{StaticResource Card}"
                Visibility="{Binding Updater.IsNotificationVisible, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="ArrowSync24"
                                   FontSize="20"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Updater.AvailableVersionText}"
                                   FontSize="13"
                                   FontWeight="600"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Updater.StatusText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Updater.IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar Value="{Binding Updater.ProgressPercent, Mode=OneWay}"
                                 Minimum="0" Maximum="100" Height="4"
                                 Background="{StaticResource Surface2Brush}"
                                 Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="{Binding Updater.ProgressText}" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="{Binding Updater.DownloadSpeedText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Download"
                               Command="{Binding Updater.DownloadCommand}"
                               Visibility="{Binding Updater.IsDownloadButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                               Icon="ArrowDownload24"
                               Appearance="Primary"
                               Height="32"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Install update"
                               Command="{Binding RequestInstallUpdateCommand}"
                               Visibility="{Binding Updater.IsInstallButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                               Icon="Checkmark24"
                               Appearance="Primary"
                               Height="32"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Cancel"
                               Command="{Binding Updater.CancelCommand}"
                               Visibility="{Binding Updater.IsCancelButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                               Icon="Dismiss24"
                               Appearance="Secondary"
                               Height="32"
                               Margin="0,0,8,0" />
                    <ui:Button Command="{Binding Updater.DismissNotificationCommand}"
                               Icon="Dismiss24"
                               Appearance="Transparent"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Height="32"
                               Width="32"
                               ToolTip="Dismiss" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: MAIN PAGE CONTENT PRESENTER -->
        <ContentPresenter Grid.Row="2"
                          Content="{Binding CurrentPageViewModel}"
                          Margin="24,16,24,24" />

        <!-- DIALOG MODAL OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000" Visibility="{Binding IsDialogVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#90020617" />
            <Border Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="#F20F121D"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="#66FCF1" BlurRadius="25" ShadowDepth="0" Opacity="0.2" />
                </Border.Effect>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Info24"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Filled="True" />
                        <TextBlock Text="{Binding DialogTitle}"
                                   FontSize="16"
                                   FontWeight="600"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding DialogMessage}"
                               Style="{StaticResource FontBase}"
                               FontSize="13"
                               Foreground="#CBD5E1"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"
                               LineHeight="20" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Command="{Binding DialogCancelCommand}"
                                Style="{StaticResource ButtonSecondary}"
                                Width="90"
                                Height="34"
                                Margin="0,0,12,0"
                                Visibility="{Binding IsDialogCancelVisible, Converter={StaticResource BoolToVisConverter}}" />
                        <Button Content="Confirm"
                                Command="{Binding DialogConfirmCommand}"
                                Style="{StaticResource ButtonSecondary}"
                                Width="100"
                                Height="34"
                                Margin="0,0,12,0"
                                Visibility="{Binding IsDialogApplyVisible, Converter={StaticResource BoolToVisConverter}}" />
                        <Button Content="Confirm"
                                Command="{Binding DialogConfirmCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                Width="100"
                                Height="34"
                                Visibility="{Binding IsDialogApplyNotVisible, Converter={StaticResource BoolToVisConverter}}" />
                        <Button Content="Apply"
                                Command="{Binding DialogApplyCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                Width="100"
                                Height="34"
                                Visibility="{Binding IsDialogApplyVisible, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- PREMIUM GLASSMORPHIC WHAT'S NEW MODAL OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1005" Visibility="{Binding IsWhatsNewVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#90020617" />
            <Border Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="#F20F121D"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#66FCF1" BlurRadius="25" ShadowDepth="0" Opacity="0.2" />
                </Border.Effect>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#1566FCF1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSync24" Foreground="{StaticResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SYSTEM UPDATED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding WhatsNewVersion, StringFormat='What\'s New in {0}'}"
                                       FontSize="16"
                                       FontWeight="600"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1" 
                               Text="We've polished the experience and added new features to make your desktop even more dynamic."
                               FontSize="13" 
                               Foreground="#CBD5E1" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,16" 
                               LineHeight="18"/>

                    <!-- Bulleted Features List -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding WhatsNewHighlights}" Margin="0,0,0,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Checkmark24" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,2,10,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding}" 
                                               Style="{StaticResource FontBase}" 
                                               FontSize="13.5"
                                               FontWeight="Medium"
                                               Foreground="#F8FAFC" 
                                               TextWrapping="Wrap" 
                                               VerticalAlignment="Top" 
                                               LineHeight="20"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Confirm Button -->
                    <Button Grid.Row="3" 
                            Content="Awesome, let's go!"
                            Command="{Binding WhatsNewCloseCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            Height="36"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
