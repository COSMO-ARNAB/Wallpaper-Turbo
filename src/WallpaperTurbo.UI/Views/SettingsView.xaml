<UserControl x:Class="WallpaperTurbo.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Settings" Style="{StaticResource TitleStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Adjust engine performance, hardware properties, and system options."
                           Style="{StaticResource SecondaryStyle}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Engine performance" Style="{StaticResource BodyStyle}" FontWeight="600" Margin="0,0,0,12" />
                            <ui:ToggleSwitch Content="Use hardware-accelerated decoding"
                                             IsChecked="{Binding UseHardwareAcceleration}"
                                             Margin="0,0,0,12"
                                             Foreground="{StaticResource TextSecondaryBrush}" />

                            <TextBlock Text="Pause profile" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
                            <ComboBox SelectedValue="{Binding ActivePauseProfile}" SelectedValuePath="Content" Width="200" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Maximized" />
                                <ComboBoxItem Content="Focused" />
                                <ComboBoxItem Content="Disabled" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Application profile" Style="{StaticResource BodyStyle}" FontWeight="600" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Software version" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding ActiveAppVersion}" Style="{StaticResource BodyStyle}" FontWeight="500" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Release channel" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding Updater.ChannelDisplay}" Style="{StaticResource BodyStyle}" FontWeight="500" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Target framework" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text=".NET 8.0-Windows" Style="{StaticResource BodyStyle}" FontWeight="500" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Software updates" Style="{StaticResource BodyStyle}" FontWeight="600" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Updater.StatusText}" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </Grid>

                            <ui:ToggleSwitch Content="Enable automatic updates"
                                             IsChecked="{Binding AutoUpdateEnabled}"
                                             Margin="0,0,0,8"
                                             Foreground="{StaticResource TextSecondaryBrush}" />
                            <ui:ToggleSwitch Content="Check for updates on startup"
                                             IsChecked="{Binding CheckOnStartup}"
                                             Margin="0,0,0,12"
                                             Foreground="{StaticResource TextSecondaryBrush}" />

                            <TextBlock Text="Release channel" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
                            <ComboBox SelectedValue="{Binding SelectedReleaseChannel}" SelectedValuePath="Content" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <ComboBoxItem Content="Stable" />
                                <ComboBoxItem Content="Beta" />
                                <ComboBoxItem Content="Dev" />
                            </ComboBox>

                            <StackPanel Margin="0,4,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Updater.IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar Value="{Binding Updater.ProgressPercent, Mode=OneWay}"
                                             Minimum="0" Maximum="100" Height="6"
                                             Background="{StaticResource Surface2Brush}"
                                             Foreground="{StaticResource AccentBrush}"
                                             BorderThickness="0" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Updater.ProgressText}" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding Updater.DownloadSpeedText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="{Binding Updater.StatusDetailText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Updater.StatusDetailText, Converter={StaticResource BoolToVisConverter}}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <Button Content="Check for updates"
                                        Command="{Binding Updater.CheckForUpdatesCommand}"
                                        IsEnabled="{Binding Updater.IsCheckButtonEnabled}"
                                        Style="{StaticResource ButtonSecondary}"
                                        Margin="0,0,8,0" />
                                <Button Content="Download"
                                        Command="{Binding Updater.DownloadCommand}"
                                        Visibility="{Binding Updater.IsDownloadButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                                        Style="{StaticResource ButtonPrimary}"
                                        Margin="0,0,8,0" />
                                <Button Content="Install update"
                                        Command="{Binding Updater.InstallCommand}"
                                        Visibility="{Binding Updater.IsInstallButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                                        Style="{StaticResource ButtonPrimary}"
                                        Margin="0,0,8,0" />
                                <Button Content="Cancel"
                                        Command="{Binding Updater.CancelCommand}"
                                        Visibility="{Binding Updater.IsCancelButtonVisible, Converter={StaticResource BoolToVisConverter}}"
                                        Style="{StaticResource ButtonSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="12,0,0,0" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Engine telemetry logs" Style="{StaticResource BodyStyle}" FontWeight="600" Margin="0,0,0,12" />

                        <Border Grid.Row="1" Background="{StaticResource Surface0Brush}" CornerRadius="{StaticResource RadiusSmall}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12" MinHeight="280">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding EngineLogsText}" FontFamily="Cascadia Code, JetBrains Mono, Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <Button Grid.Row="2" Content="Refresh logs" Command="{Binding RefreshLogsCommand}" Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
