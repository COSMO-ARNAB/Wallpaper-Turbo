<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ======================================================= -->
    <!-- GLASSMORPHISM STYLES - PREMIUM GRADIENT FROSTED GLASS   -->
    <!-- Merged locally inside MinimalLayoutView to isolate Techie-->
    <!-- ======================================================= -->

    <!-- Card Style Override -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#11141B" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#FFFFFF" Opacity="0.06" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="4" Opacity="0" />
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <!-- Frosted Glass Gradient (White gradient overlay over blurred desktop) -->
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1FFFFFFF" Offset="0" />
                            <GradientStop Color="#08FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <!-- Specular Border Highlight (Simulates crisp glass edges) -->
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#50FFFFFF" Offset="0" />
                            <GradientStop Color="#12FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.18" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- CardHover Style Override -->
    <Style x:Key="CardHover" TargetType="Border" BasedOn="{StaticResource Card}">
        <Style.Triggers>
            <!-- MouseOver behavior when Solid (IsWallpaperVisible = False) -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="#181C26" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="#FFFFFF" Opacity="0.12" />
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>

            <!-- MouseOver behavior when Glass (IsWallpaperVisible = True) -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33FFFFFF" Offset="0" />
                            <GradientStop Color="#14FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#77FFFFFF" Offset="0" />
                            <GradientStop Color="#30FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#5EE9FF" BlurRadius="16" ShadowDepth="0" Opacity="0.30" />
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- CardButton Style Override -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#11141B" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#FFFFFF" Opacity="0.06" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="4" Opacity="0" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <!-- =================================================== -->
                        <!-- SOLID STATE TRIGGERS (IsWallpaperVisible = False)   -->
                        <!-- =================================================== -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#181C26" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Border" Property="BorderBrush">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFFFFF" Opacity="0.10" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#222836" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>

                        <!-- =================================================== -->
                        <!-- GLASS STATE TRIGGERS (IsWallpaperVisible = True)    -->
                        <!-- =================================================== -->
                        <DataTrigger Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="Border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1AFFFFFF" Offset="0" />
                                        <GradientStop Color="#05FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Border" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#40FFFFFF" Offset="0" />
                                        <GradientStop Color="#0DFFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="4" Opacity="0.15" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <!-- MouseOver in Glass State -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2EFFFFFF" Offset="0" />
                                        <GradientStop Color="#0FFFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Border" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#66FFFFFF" Offset="0" />
                                        <GradientStop Color="#26FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#5EE9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.25" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>

                        <!-- Pressed in Glass State -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#42FFFFFF" Offset="0" />
                                        <GradientStop Color="#1AFFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ButtonGhost Style Override -->
    <Style x:Key="ButtonGhost" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="500" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Solid State Hover -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Surface2Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </MultiDataTrigger>

                        <!-- Glass State Hover -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.Presentation.IsWallpaperVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFFFFF" Opacity="0.25" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================= -->
    <!-- MINIMAL LAYOUT APPLE LIQUID GLASS TOGGLE SWITCH         -->
    <!-- Glassmorphic Liquid Blur & Elastic Spring Physics        -->
    <!-- ======================================================= -->

    <SolidColorBrush x:Key="AppleSwitchTrackOffBrush" Color="#2A2F40" />
    <SolidColorBrush x:Key="AppleSwitchTrackOnBrush" Color="#34C759" />

    <LinearGradientBrush x:Key="AppleGlassTrackBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#50FFFFFF" Offset="0" />
        <GradientStop Color="#15FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppleGlassThumbBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E6F2EC" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="AppleToggleSwitchStyle" TargetType="{x:Type ui:ToggleSwitch}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                    <Grid x:Name="RootGrid" Width="46" Height="24" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- 1. Outer Liquid Green Glow -->
                        <Border x:Name="GlowEffect" CornerRadius="12" Opacity="0" Background="{StaticResource AppleSwitchTrackOnBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#34C759" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
                            </Border.Effect>
                        </Border>

                        <!-- 2. Track OFF Background (Dark Glass) -->
                        <Border x:Name="TrackBackground" 
                                CornerRadius="12" 
                                Background="{StaticResource AppleSwitchTrackOffBrush}" 
                                BorderBrush="{StaticResource AppleGlassTrackBorderBrush}" 
                                BorderThickness="1" />

                        <!-- 3. Track ON Background (iOS Green) -->
                        <Border x:Name="TrackActiveBackground" 
                                CornerRadius="12" 
                                Background="{StaticResource AppleSwitchTrackOnBrush}" 
                                BorderBrush="{StaticResource AppleGlassTrackBorderBrush}"
                                BorderThickness="1"
                                Opacity="0" />

                        <!-- 4. Liquid Glass Motion Blur Trail -->
                        <Border x:Name="LiquidTrail" 
                                Width="24" 
                                Height="18" 
                                CornerRadius="9" 
                                Background="#66FFFFFF" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center" 
                                Margin="3,0,0,0"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <BlurEffect Radius="12" KernelType="Gaussian" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="LiquidTrailScale" ScaleX="1.0" ScaleY="1.0" />
                                    <TranslateTransform x:Name="LiquidTrailTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>

                        <!-- 5. Glass Thumb Knob with Specular Highlight -->
                        <Border x:Name="ThumbKnob" 
                                Width="18" 
                                Height="18" 
                                CornerRadius="9" 
                                Background="{StaticResource AppleGlassThumbBrush}" 
                                BorderBrush="#70FFFFFF"
                                BorderThickness="1"
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center" 
                                Margin="3,0,0,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1.5" Opacity="0.28" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ThumbScale" ScaleX="1.0" ScaleY="1.0" />
                                    <TranslateTransform x:Name="ThumbTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Checked State (ON) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Thumb Translation -->
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate" 
                                                         Storyboard.TargetProperty="X" 
                                                         To="22" 
                                                         Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CircleEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <!-- Elastic Glass Stretch Animation -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale" 
                                                                       Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.10" Value="1.18" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1.00" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <!-- Liquid Blur Trail Animation -->
                                        <DoubleAnimation Storyboard.TargetName="LiquidTrailTranslate" 
                                                         Storyboard.TargetProperty="X" 
                                                         To="18" 
                                                         Duration="0:0:0.22" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LiquidTrail" 
                                                                       Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0.00" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <!-- Background & Glow Fade -->
                                        <DoubleAnimation Storyboard.TargetName="TrackActiveBackground" 
                                                         Storyboard.TargetProperty="Opacity" 
                                                         To="1" 
                                                         Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="GlowEffect" 
                                                         Storyboard.TargetProperty="Opacity" 
                                                         To="1" 
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Thumb Translation OFF -->
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate" 
                                                         Storyboard.TargetProperty="X" 
                                                         To="0" 
                                                         Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CircleEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <!-- Elastic Glass Stretch Animation OFF -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale" 
                                                                       Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.10" Value="1.18" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1.00" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <!-- Liquid Blur Trail Animation OFF -->
                                        <DoubleAnimation Storyboard.TargetName="LiquidTrailTranslate" 
                                                         Storyboard.TargetProperty="X" 
                                                         To="0" 
                                                         Duration="0:0:0.22" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LiquidTrail" 
                                                                       Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0.00" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <!-- Background & Glow Fade OFF -->
                                        <DoubleAnimation Storyboard.TargetName="TrackActiveBackground" 
                                                         Storyboard.TargetProperty="Opacity" 
                                                         To="0" 
                                                         Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="GlowEffect" 
                                                         Storyboard.TargetProperty="Opacity" 
                                                         To="0" 
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootGrid" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit Override for ui:ToggleSwitch in Minimal Layout -->
    <Style TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource AppleToggleSwitchStyle}" />

</ResourceDictionary>
